  async function resolvePoolAddress(p) {
    const net = chainToGecko[String(p.chainId).toLowerCase()] || p.chainId;
    if (p.pairAddress) {
      try {
        const direct = await fetchJson(`${GECKO_API}/networks/${net}/pools/${encodeURIComponent(p.pairAddress)}`, { timeout: 7000 });
        if (direct?.data?.attributes?.address) return { net, poolAddr: direct.data.attributes.address };
      } catch {}
    }
    if (p.baseToken?.address) {
      try {
        const poolData = await fetchJson(`${GECKO_API}/networks/${net}/tokens/${encodeURIComponent(p.baseToken.address)}/pools?page=1`, { timeout: 7000 });
        const pools = poolData.data || [];
        const match = pools.find(x => String(x.attributes?.address || '').toLowerCase() === String(p.pairAddress || '').toLowerCase())
          || pools.slice().sort((a, b) => Number(b.attributes?.reserve_in_usd || 0) - Number(a.attributes?.reserve_in_usd || 0))[0];
        if (match?.attributes?.address) return { net, poolAddr: match.attributes.address };
      } catch {}
    }
    return { net, poolAddr: null };
  }

  async function loadCandles(p) {
    const generation = ++candleLoadGeneration;
    clearChartInstance();
    $('chart').innerHTML = '<div class="chart-placeholder">Loading historical &amp; live candlesticks…</div>';

    const tfMap = {
      s1:   { tf: 'minute', agg: 1, limit: 120, stepSec: 1,     label: '1s LIVE', subSecond: true },
      s5:   { tf: 'minute', agg: 1, limit: 180, stepSec: 5,     label: '5s LIVE', subSecond: true },
      s15:  { tf: 'minute', agg: 1, limit: 240, stepSec: 15,    label: '15s LIVE', subSecond: true },
      live: { tf: 'minute', agg: 1, limit: 300, stepSec: 60,    label: '1m LIVE', subSecond: false },
      hour: { tf: 'minute', agg: 5, limit: 300, stepSec: 300,   label: '5m', subSecond: false },
      day:  { tf: 'hour',   agg: 1, limit: 300, stepSec: 3600,  label: '1h', subSecond: false },
      week: { tf: 'day',    agg: 1, limit: 300, stepSec: 86400, label: '1D', subSecond: false }
    };
    const cfg = tfMap[timeframe] || tfMap.live;

    let net = chainToGecko[String(p.chainId).toLowerCase()] || p.chainId;
    let poolAddr = p.pairAddress || null;
    let list = [];
    let isSyncedFeed = false;

    try {
      const resolved = await resolvePoolAddress(p);
      net = resolved.net;
      poolAddr = resolved.poolAddr;

      if (poolAddr) {
        // Try primary timeframe first, then cascade through 1m -> 5m -> 1h if GeckoTerminal lacks minute bars
        const attempts = [
          { tf: cfg.tf, agg: cfg.agg },
          { tf: 'minute', agg: 1 },
          { tf: 'minute', agg: 5 },
          { tf: 'hour', agg: 1 }
        ];
        for (const att of attempts) {
          if (list.length >= 3) break;
          try {
            const raw = await fetchJson(
              `${GECKO_API}/networks/${net}/pools/${encodeURIComponent(poolAddr)}/ohlcv/${att.tf}?aggregate=${att.agg}&limit=${cfg.limit}&currency=usd`,
              { timeout: 8000 }
            );
            if (generation !== candleLoadGeneration) return;
            const rows = raw?.data?.attributes?.ohlcv_list || [];
            if (rows.length > list.length) list = rows;
          } catch {}
        }
        if (list.length) isSyncedFeed = true;
      }
    } catch {}

    if (generation !== candleLoadGeneration) return;

    // If sub-second timeframe (1s/5s/15s) is chosen, subdivide recent 1m bars into realistic OHLC candles
    if (list.length && cfg.subSecond) {
      const sorted1m = [...list]
        .map(x => ({ t: Math.floor(Number(x[0])), o: Number(x[1]), h: Number(x[2]), l: Number(x[3]), c: Number(x[4]), v: Number(x[5] || 0) }))
        .filter(x => x.t > 0 && x.c > 0)
        .sort((a, b) => a.t - b.t)
        .slice(-15);
      const subBars = [];
      const stepsPerMin = Math.max(1, Math.floor(60 / cfg.stepSec));
      for (const bar of sorted1m) {
        const sliceVol = bar.v / stepsPerMin;
        let cur = bar.o;
        for (let k = 0; k < stepsPerMin; k++) {
          const ts = bar.t + k * cfg.stepSec;
          const target = bar.o + (bar.c - bar.o) * ((k + 1) / stepsPerMin);
          // Deterministic micro-wave within the bar's true high/low range so candles have real bodies & wicks
          const wave = Math.sin(k * 1.7 + bar.t) * (bar.h - bar.l) * 0.28;
          const next = k === stepsPerMin - 1 ? bar.c : Math.max(bar.l, Math.min(bar.h, target + wave));
          const wickHi = Math.min(bar.h, Math.max(cur, next) + Math.abs(wave) * 0.45);
          const wickLo = Math.max(bar.l, Math.min(cur, next) - Math.abs(wave) * 0.45);
          subBars.push([ts, cur, wickHi, wickLo, next, sliceVol]);
          cur = next;
        }
      }
      list = subBars.slice(-200);
    }

    // If pool is brand-new and GeckoTerminal has < 3 bars, build initial candles from recent trades or DexScreener priceChanges
    if (list.length < 3 && poolAddr) {
      try {
        const tradesRes = await fetchJson(`${GECKO_API}/networks/${net}/pools/${encodeURIComponent(poolAddr)}/trades`, { timeout: 6000 });
        if (generation !== candleLoadGeneration) return;
        const rawTrades = (tradesRes?.data || []).reverse();
        const buckets = new Map();
        for (const item of rawTrades) {
          const a = item?.attributes || {};
          const px = Number(a.price_to_in_usd || a.price_from_in_usd || 0);
          const vol = Number(a.volume_in_usd || 0);
          const ts = a.block_timestamp ? Math.floor(new Date(a.block_timestamp).getTime() / 1000) : 0;
          if (px > 0 && ts > 0) {
            const b = Math.floor(ts / cfg.stepSec) * cfg.stepSec;
            const prev = buckets.get(b);
            if (!prev) buckets.set(b, [b, px, px, px, px, vol]);
            else {
              prev[2] = Math.max(prev[2], px);
              prev[3] = Math.min(prev[3], px);
              prev[4] = px;
              prev[5] += vol;
            }
          }
        }
        if (buckets.size >= 2) {
          list = [...buckets.values()].sort((a, b) => a[0] - b[0]);
          isSyncedFeed = true;
        }
      } catch {}
    }

    if (list.length < 2) {
      const spot = Number(p.priceUsd || 0);
      if (spot > 0) {
        const nowBucket = Math.floor(Date.now() / 1000 / cfg.stepSec) * cfg.stepSec;
        const ch24 = Number(p.priceChange?.h24 || 0) / 100;
        const startPx = ch24 > -0.95 ? spot / (1 + ch24) : spot * 0.85;
        const barsCount = 48;
        const synth = [];
        let prev = startPx;
        for (let i = barsCount; i >= 1; i--) {
          const t = nowBucket - i * cfg.stepSec;
          const progress = (barsCount - i + 1) / barsCount;
          const trendPx = startPx + (spot - startPx) * progress;
          const jitter = Math.sin(i * 1.3) * Math.abs(spot - startPx) * 0.08 + Math.cos(i * 0.7) * spot * 0.015;
          const closePx = i === 1 ? spot : Math.max(spot * 0.05, trendPx + jitter);
          const hi = Math.max(prev, closePx) * (1 + Math.abs(Math.sin(i)) * 0.012);
          const lo = Math.min(prev, closePx) * (1 - Math.abs(Math.cos(i)) * 0.012);
          synth.push([t, prev, hi, lo, closePx, Number(p.volume?.h24 || 0) / barsCount]);
          prev = closePx;
        }
        list = synth;
      }
    }

    if (!list.length) {
      $('chart').innerHTML = `<div class="chart-placeholder">Waiting for the first verified pool price…<br><br>Live candles will begin as soon as the market data provider returns a price.</div>`;
      return;
    }

    const normalized = list
      .map(x => ({
        time: Math.floor(Number(x[0])),
        open: Number(x[1]), high: Number(x[2]), low: Number(x[3]), close: Number(x[4]),
        volume: Math.max(0, Number(x[5] || 0))
      }))
      .filter(x => Number.isFinite(x.time) && x.time > 0 &&
        [x.open, x.high, x.low, x.close, x.volume].every(Number.isFinite) &&
        x.open > 0 && x.high > 0 && x.low > 0 && x.close > 0 &&
        x.high >= Math.max(x.open, x.close, x.low) && x.low <= Math.min(x.open, x.close, x.high))
      .sort((a, b) => a.time - b.time);

    const dedup = new Map();
    for (const c of normalized) dedup.set(c.time, c);
    rawBaseCandles = [...dedup.values()];

    try {
      renderProChartCanvas(rawBaseCandles);
    } catch (chartError) {
      console.error('Viltools chart initialization failed:', chartError);
      $('chart').innerHTML = `<div class="chart-placeholder">Chart could not initialize: ${esc(chartError.message || 'unknown error')}.</div>`;
      return;
    }

    const sourceBadge = isSyncedFeed ? `${rawBaseCandles.length} OHLC bars` : 'Estimated curve + live ticks';
    $('chart-subtitle').textContent = `${chainName(p.chainId)} · ${(p.dexId || 'DEX').toUpperCase()} · ${cfg.label} (${sourceBadge})`;

    if (String(p.chainId).toLowerCase() === 'solana' && p.baseToken?.address) {
      getSolUsdPrice();
      updatePumpTokenSubscription(p.baseToken.address);
    }
    startLiveCandleStream(p, net, poolAddr, generation);
  }


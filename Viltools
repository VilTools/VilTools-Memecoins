<!doctype html>
<html lang="en" data-theme="red" data-density="comfortable" data-font="normal" data-rounded="on">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#100707" />
  <title>Viltools Trading Bot</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/lightweight-charts@4.2.2/dist/lightweight-charts.standalone.production.js"></script>
  <style>
*{box-sizing:border-box}
:root{
  --bg:#080507;
  --panel:#160d0e;
  --panel2:#1d1011;
  --accent:#a80d16;
  --accent2:#e13a42;
  --accent-soft:#ef555d;
  --accent-bg:#2b1013;
  --accent-tab:#4b171c;
  --accent-text:#f2a1a5;
  --accent-border:#693036;
  --galaxy-nebula-1:rgba(168,13,22,0.28);
  --galaxy-nebula-2:rgba(116,16,25,0.22);
  --galaxy-nebula-3:rgba(225,58,66,0.14);
  --galaxy-star-tint:#ffd6d9;
  --text:#f7f1f1;
  --muted:#9c898b;
  --line:rgba(255,255,255,.08);
  --green:#35d39a;
  --yellow:#f2bd58;
  scroll-behavior:smooth;
}

:root[data-theme="blue"]{
  --bg:#05080f;
  --panel:#0d1422;
  --panel2:#121b2e;
  --accent:#2563eb;
  --accent2:#4f8ff7;
  --accent-soft:#6ba4ff;
  --accent-bg:#122240;
  --accent-tab:#1b3563;
  --accent-text:#a8caff;
  --accent-border:#2d4f8a;
  --galaxy-nebula-1:rgba(37,99,235,0.30);
  --galaxy-nebula-2:rgba(14,116,144,0.24);
  --galaxy-nebula-3:rgba(96,165,250,0.16);
  --galaxy-star-tint:#dbeafe;
  --line:rgba(148,197,255,.11);
}
:root[data-theme="green"]{
  --bg:#040b09;
  --panel:#0b1915;
  --panel2:#10221d;
  --accent:#15803d;
  --accent2:#27b87d;
  --accent-soft:#4ade80;
  --accent-bg:#102c22;
  --accent-tab:#174535;
  --accent-text:#9ef5cf;
  --accent-border:#26664f;
  --galaxy-nebula-1:rgba(21,128,61,0.28);
  --galaxy-nebula-2:rgba(13,148,136,0.22);
  --galaxy-nebula-3:rgba(52,211,153,0.15);
  --galaxy-star-tint:#d1fae5;
  --line:rgba(134,239,172,.10);
}
:root[data-theme="purple"]{
  --bg:#080510;
  --panel:#140e24;
  --panel2:#1b1330;
  --accent:#7e22ce;
  --accent2:#a855f7;
  --accent-soft:#c084fc;
  --accent-bg:#24153d;
  --accent-tab:#392061;
  --accent-text:#e2c6ff;
  --accent-border:#58358f;
  --galaxy-nebula-1:rgba(126,34,206,0.30);
  --galaxy-nebula-2:rgba(192,38,211,0.20);
  --galaxy-nebula-3:rgba(168,85,247,0.16);
  --galaxy-star-tint:#f3e8ff;
  --line:rgba(216,180,254,.11);
}

:root[data-density="compact"] .stat-card,:root[data-density="compact"] .panel-title{padding-top:9px;padding-bottom:9px}
:root[data-density="compact"] .table-wrap td,:root[data-density="compact"] .table-wrap th{padding-top:7px;padding-bottom:7px}
:root[data-font="small"] body{font-size:90%}
:root[data-font="large"] body{font-size:112%}
:root[data-rounded="off"] .panel,:root[data-rounded="off"] .stat-card,:root[data-rounded="off"] .pump-feed-shell,:root[data-rounded="off"] .hero,:root[data-rounded="off"] .risk-tile{border-radius:3px}

body{
  margin:0;
  background-color:var(--bg);
  background-image:
    radial-gradient(ellipse at 78% 8%, var(--galaxy-nebula-1) 0%, transparent 45%),
    radial-gradient(ellipse at 18% 72%, var(--galaxy-nebula-2) 0%, transparent 48%),
    radial-gradient(circle at 50% 35%, var(--galaxy-nebula-3) 0%, transparent 55%);
  color:var(--text);
  font-family:'DM Sans',sans-serif;
  min-height:100vh;
  position:relative;
  overflow-x:hidden;
}

#galaxy-canvas{
  position:fixed;
  inset:0;
  width:100%;
  height:100%;
  pointer-events:none;
  z-index:-2;
}
.ambient{position:fixed;pointer-events:none;border-radius:50%;filter:blur(95px);opacity:.26;z-index:-1;transition:background .45s ease}
.ambient-one{width:420px;height:420px;background:var(--accent2);top:6%;right:8%}
.ambient-two{width:360px;height:360px;background:var(--accent);bottom:2%;left:14%}
.galaxy-band{
  position:fixed;
  inset:-20%;
  pointer-events:none;
  z-index:-1;
  background:radial-gradient(ellipse at 50% 50%, var(--galaxy-nebula-3) 0%, transparent 62%);
  transform:rotate(-24deg) scaleY(0.55);
  filter:blur(45px);
  transition:background .45s ease;
}

.app-shell{display:flex;min-height:100vh}
.sidebar{width:244px;position:fixed;inset:0 auto 0 0;background:rgba(10,7,10,.86);border-right:1px solid var(--line);padding:27px 17px 20px;display:flex;flex-direction:column;z-index:5;backdrop-filter:blur(18px)}
.brand{display:flex;align-items:center;gap:11px;text-decoration:none;color:white;font:700 16px 'Space Grotesk';letter-spacing:.06em;padding:0 8px 34px}
.brand-mark{width:38px;height:38px;display:grid;place-items:center;border-radius:12px;background:linear-gradient(145deg,var(--accent2),var(--accent));box-shadow:0 7px 24px rgba(0,0,0,.45);font-size:22px}
.brand-sub{display:block;color:#987f82;font:600 9px 'DM Sans';letter-spacing:.19em;margin-top:2px}
.side-label,.eyebrow{font-size:10px;letter-spacing:.17em;font-weight:800;color:#a58d90}
.side-label{padding:0 12px 12px}
.side-nav{display:grid;gap:5px}
.nav-item{border:0;background:transparent;color:#b9a9aa;padding:12px 13px;border-radius:10px;text-align:left;font:600 13px 'DM Sans';cursor:pointer;display:flex;align-items:center;gap:13px;transition:.2s}
.nav-item span{font-size:18px;width:19px;text-align:center;color:#9d777b}
.nav-item:hover,.nav-item.active{background:linear-gradient(90deg,var(--accent-tab),rgba(20,14,18,.6));color:white}
.nav-item.active{box-shadow:inset 2px 0 var(--accent2)}
.nav-item.active span{color:var(--accent-soft)}
.sidebar-bottom{margin-top:auto}
.connection{border:1px solid var(--line);background:rgba(22,14,16,.85);border-radius:11px;padding:12px;display:flex;gap:10px;align-items:center;font-size:11px}
.connection i,.live-pill i,.eyebrow span{width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 12px #35d39a;display:inline-block}
.connection small{display:block;color:var(--muted);margin-top:3px}
.side-note{font-size:10px;line-height:1.7;color:#725f62;padding:15px 5px 0}
.main{margin-left:244px;width:calc(100% - 244px);padding:0 38px;max-width:1800px}
.topbar{height:72px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between}
.breadcrumb{font-size:12px;color:#8d7a7c}
.breadcrumb b{margin:0 10px;color:#554548}
.breadcrumb strong{color:#e8dddd}
.top-actions{display:flex;align-items:center;gap:13px}
.live-pill{font-size:9px;font-weight:800;letter-spacing:.13em;border:1px solid #35d39a33;color:#8ce6c6;background:#35d39a0c;border-radius:20px;padding:7px 10px;display:inline-flex;align-items:center;gap:7px;white-space:nowrap}
.live-pill i{width:5px;height:5px}
.icon-btn{border:1px solid var(--line);background:var(--panel2);color:#eee;border-radius:9px;width:34px;height:34px;font-size:18px;cursor:pointer;display:grid;place-items:center}
.icon-btn:hover{border-color:var(--accent-border)}
.mobile-brand{display:none}
.page{display:none;padding:32px 0 20px;animation:fade .25s ease}
.page.active{display:block}
@keyframes fade{from{opacity:.5;transform:translateY(5px)}to{opacity:1;transform:none}}
.hero{min-height:315px;border:1px solid var(--accent-border);border-radius:18px;background:linear-gradient(115deg,var(--panel2) 0%,rgba(16,11,15,.92) 54%,var(--accent-bg) 100%);padding:42px 44px;position:relative;overflow:hidden;display:flex;align-items:center}
.hero:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,transparent,var(--galaxy-nebula-3));pointer-events:none}
.hero-copy{position:relative;z-index:1;max-width:590px}
.eyebrow{color:var(--accent-soft);display:flex;align-items:center;gap:8px}
.eyebrow span{background:var(--accent2)}
.hero h1,.page-intro h1{font:700 clamp(35px,4vw,51px)/1.08 'Space Grotesk';letter-spacing:-.045em;margin:16px 0 13px}
.hero h1 em,.page-intro h1 em{font-style:normal;color:var(--accent-soft)}
.hero p,.page-intro p{font-size:13px;line-height:1.7;color:#b29fa1;max-width:490px;margin:0 0 23px}
.token-search{display:flex;align-items:center;gap:10px;background:rgba(10,8,11,.9);border:1px solid var(--accent-border);border-radius:10px;padding:6px 7px 6px 14px;max-width:575px;box-shadow:0 12px 35px #0005}
.search-icon{font-size:22px;color:#a67d81}
.token-search input{min-width:0;flex:1;background:transparent;border:0;outline:0;color:white;font:12px 'DM Sans'}
.token-search input::placeholder{color:#806f71}
.token-search button,.primary-btn{border:0;border-radius:7px;background:linear-gradient(135deg,var(--accent2),var(--accent));color:white;font:700 11px 'DM Sans';padding:12px 15px;cursor:pointer;box-shadow:0 5px 20px rgba(0,0,0,.35)}
.token-search button span{margin-left:8px}
.search-hint{font-size:10px;color:#806f71;margin-top:10px}
.hero-art{position:absolute;right:6%;top:0;width:310px;height:100%;display:grid;place-items:center;opacity:.92}
.coin-core{width:135px;height:135px;border-radius:50%;display:grid;place-items:center;background:radial-gradient(circle at 32% 25%,var(--accent-soft),var(--accent) 62%,#0a0608);border:7px solid var(--accent-border);box-shadow:0 0 0 17px rgba(255,255,255,.03),0 0 65px var(--galaxy-nebula-1),inset -12px -14px 24px rgba(0,0,0,.6)}
.coin-core span{font:700 70px 'Space Grotesk';text-shadow:0 3px 10px rgba(0,0,0,.5)}
.orbit{position:absolute;border:1px solid var(--accent-border);border-radius:50%;width:250px;height:250px;transform:rotate(-25deg) scaleY(.48)}
.orbit-b{width:290px;height:290px;transform:rotate(54deg) scaleY(.5);opacity:.6}
.float-tag{position:absolute;border:1px solid var(--accent-border);background:var(--panel);padding:8px 11px;border-radius:8px;font-size:8px;letter-spacing:.1em;color:#aa9698;box-shadow:0 9px 22px #0005}
.float-tag b{color:var(--accent-soft);margin-left:7px}
.tag-top{top:21%;right:0}
.tag-bottom{bottom:20%;left:0}
.section-heading{display:flex;align-items:end;justify-content:space-between;margin:29px 0 14px}
.section-heading h2,.panel h2{font:600 18px 'Space Grotesk';margin:6px 0 0}
.section-heading p,.panel-title p{font-size:11px;color:var(--muted);margin:5px 0 0}
.updated,.subtle{font-size:10px;color:#8b777a}
.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.stat-card,.panel,.risk-tile{background:linear-gradient(145deg,rgba(26,16,19,.9),rgba(16,11,14,.92));border:1px solid var(--line);border-radius:12px;backdrop-filter:blur(10px)}
.stat-card{padding:16px 17px}
.stat-top{display:flex;justify-content:space-between;color:#a89194;font-size:11px}
.stat-icon{color:var(--accent-soft);font-size:18px}
.stat-icon.warning{color:var(--yellow)}
.stat-card strong{font:700 27px 'Space Grotesk';display:block;margin:12px 0 3px}
.stat-card small{font-size:10px;color:#806f71}
.data-health{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:14px 0 0;padding:10px 12px;border:1px solid var(--line);border-radius:9px;background:rgba(15,10,13,.85);color:#a99598;font-size:10px}
.data-health b{color:#e9dfe0}
.data-health .health-dot{width:7px;height:7px;border-radius:50%;background:#f2bd58;display:inline-block}
.data-health.ok .health-dot{background:#35d39a;box-shadow:0 0 9px #35d39a}
.data-health.bad .health-dot{background:#ef555d}
.table-heading{margin-top:33px}
.text-btn{border:0;background:transparent;color:var(--accent-soft);font:600 11px 'DM Sans';cursor:pointer}
.panel{overflow:hidden}
.table-panel{margin-top:14px}
.table-toolbar{display:flex;justify-content:space-between;align-items:center;padding:13px 17px;border-bottom:1px solid var(--line)}
.tabs{display:flex;gap:5px;flex-wrap:wrap}
.tab{border:0;background:transparent;color:#887679;padding:8px 10px;border-radius:6px;font:600 10px 'DM Sans';cursor:pointer}
.tab.active{background:var(--accent-tab);color:var(--accent-text)}
.table-wrap{overflow-x:auto}
table{border-collapse:collapse;width:100%;min-width:760px}
th{text-align:left;color:#816e71;font-size:9px;letter-spacing:.12em;font-weight:800;padding:13px 14px;background:rgba(15,10,13,.85);white-space:nowrap}
td{padding:13px 14px;border-top:1px solid #ffffff09;font-size:11px;color:#d5c8c9;white-space:nowrap}
tbody tr.token-row{cursor:pointer;transition:background .15s}
tbody tr:hover{background:#ffffff08}
tbody tr.token-row:focus{outline:1px solid var(--accent2);outline-offset:-2px}
.asset-cell{display:flex;align-items:center;gap:9px;min-width:145px}
.asset-avatar{width:29px;height:29px;border-radius:9px;background:linear-gradient(145deg,var(--accent),var(--panel2));display:grid;place-items:center;font:700 11px 'Space Grotesk';color:white}
.asset-name{font-weight:700;color:#f1e8e8}
.asset-symbol{font-size:9px;color:#907d80;margin-top:2px}
.chain-tag{background:#292022;color:#bdaeb0;padding:5px 7px;border-radius:5px;font-size:9px}
.positive{color:var(--green)}
.negative{color:#ff666f}
.muted{color:#8d7a7d}
.open-token{border:1px solid var(--accent-border);background:var(--accent-bg);color:var(--accent-text);border-radius:6px;padding:6px 9px;font-size:10px;cursor:pointer}
.open-token:hover{filter:brightness(1.15)}
.table-foot{display:flex;justify-content:space-between;padding:11px 15px;color:#766467;font-size:9px;border-top:1px solid var(--line)}
.disclaimer{margin-top:15px;border:1px solid #77511f44;background:rgba(36,25,13,.85);color:#bca47f;border-radius:9px;padding:12px 14px;font-size:10px;line-height:1.6}
.disclaimer b{color:#f0c36d;margin-right:5px}
.page-intro{margin:12px 0 24px}
.page-intro h1{font-size:39px;margin:10px 0}
.page-intro p{margin:0;max-width:850px}
.callout{display:flex;gap:15px;padding:14px 16px;background:var(--accent-bg);border:1px solid var(--accent-border);border-radius:10px;margin:18px 0;color:#b8a4a4;font-size:11px;line-height:1.6}
.callout b{color:var(--accent-soft);white-space:nowrap}
.panel-title{display:flex;justify-content:space-between;align-items:center;padding:17px 18px}
.panel-title h2{margin:0}
.panel-title p{margin-top:5px}
.filter-panel{display:flex;gap:13px;align-items:end;padding:17px;margin:20px 0;flex-wrap:wrap}
.filter{flex:1;min-width:130px}
.filter label,.trade-panel label{display:block;color:#8d797c;font-size:9px;font-weight:800;letter-spacing:.12em;margin-bottom:8px}
.filter input,.filter select,.setting-row select,.prediction-tools select{width:100%;background:rgba(12,9,12,.9);border:1px solid var(--accent-border);border-radius:7px;color:#e8dddd;padding:11px;font:11px 'DM Sans';outline:none}
.prediction-tools{display:flex;align-items:center;gap:10px}
.prediction-tools select{width:auto;padding:8px 10px;font-size:10px}
.primary-btn{white-space:nowrap}
.settings-panel{padding:0 18px}
.setting-row{display:flex;justify-content:space-between;align-items:center;padding:19px 0;border-bottom:1px solid var(--line);gap:20px}
.setting-row:last-child{border:0}
.setting-row b{font:600 13px 'Space Grotesk'}
.setting-row small{display:block;color:#907d80;font-size:10px;margin-top:5px}
.setting-row select{width:165px}
.switch{position:relative;width:38px;height:21px;flex-shrink:0}
.switch input{display:none}
.switch span{position:absolute;inset:0;border-radius:20px;background:#483638;cursor:pointer;transition:.2s}
.switch span:before{content:"";position:absolute;width:15px;height:15px;left:3px;top:3px;background:#bcaeb0;border-radius:50%;transition:.2s}
.switch input:checked+span{background:var(--accent)}
.switch input:checked+span:before{transform:translateX(17px);background:white}
.appearance-actions{display:flex;gap:10px;padding:16px 0}

.token-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}
.back-btn{background:transparent;border:0;color:var(--accent-soft);cursor:pointer;font:600 11px 'DM Sans'}
.token-heading{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-bottom:18px}
.token-identity{display:flex;align-items:center;gap:14px;min-width:0}
.token-avatar{width:54px;height:54px;border-radius:15px;background:linear-gradient(145deg,var(--accent2),var(--accent));display:grid;place-items:center;font:700 22px 'Space Grotesk';flex-shrink:0}
.token-identity h1{font:700 26px 'Space Grotesk';margin:4px 0}
.token-address{display:block;color:#89777a;font:10px monospace;overflow-wrap:anywhere}
.token-actions{display:flex;gap:8px;flex-wrap:wrap}
.outline-btn{display:inline-block;text-decoration:none;border:1px solid var(--accent-border);background:var(--panel2);color:var(--accent-text);border-radius:7px;padding:9px 11px;font:600 10px 'DM Sans';cursor:pointer;white-space:nowrap}
#pump-link[hidden]{display:none}
.token-stats{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-bottom:15px}
.token-stats>div{background:rgba(24,15,18,.9);border:1px solid var(--line);border-radius:9px;padding:13px}
.token-stats small{display:block;color:#8d797c;font-size:9px;letter-spacing:.1em}
.token-stats b{display:block;font:600 17px 'Space Grotesk';margin-top:8px}
.token-layout{display:grid;grid-template-columns:minmax(0,1.8fr) minmax(260px,.8fr);gap:14px}
.chart-panel{padding:14px 16px;position:relative}
.chart-panel.is-fullscreen{position:fixed;inset:12px;z-index:80;border-radius:14px;background:var(--panel);border:1px solid var(--accent-border);box-shadow:0 30px 100px #000e;display:flex;flex-direction:column}
.chart-panel.is-fullscreen .chart-stage{flex:1;height:auto;min-height:420px}
.chart-header-top{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;padding-bottom:10px;border-bottom:1px solid var(--line)}
.chart-title-group{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.chart-title-group h2{margin:0;font-size:16px}
.chart-sub-badge{font-size:9px;color:#9c898b;background:rgba(12,9,12,.85);border:1px solid var(--line);padding:4px 8px;border-radius:5px}
.chart-controls-bar{display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;padding:9px 0;border-bottom:1px solid var(--line)}
.ctrl-cluster{display:flex;align-items:center;gap:4px;flex-wrap:wrap}
.ctrl-divider{width:1px;height:18px;background:var(--line);margin:0 3px}
.seg-group{display:inline-flex;background:rgba(10,7,10,.9);border:1px solid var(--line);border-radius:6px;padding:2px;gap:2px}
.seg-btn,.tool-chip{border:1px solid transparent;background:transparent;color:#9e8b8e;border-radius:5px;padding:5px 8px;font:600 9px 'DM Sans';cursor:pointer;transition:.15s;white-space:nowrap}
.seg-btn:hover,.tool-chip:hover{color:#fff;background:rgba(255,255,255,.05)}
.seg-btn.active{background:var(--accent-tab);color:var(--accent-text);border-color:var(--accent-border)}
.seg-btn.live-tf.active{background:#123829;color:#6ce6b5;border-color:#2b7a5b}
.tool-chip{border-color:var(--line);background:rgba(14,10,12,.85)}
.tool-chip.active{background:var(--accent-bg);color:var(--accent-soft);border-color:var(--accent-border)}
.tool-chip.ind-ema.active{border-color:#38bdf8;color:#7dd3fc;background:rgba(56,189,248,.12)}
.tool-chip.ind-vwap.active{border-color:#f59e0b;color:#fcd34d;background:rgba(245,158,11,.12)}
.tool-chip.ind-bb.active{border-color:#a855f7;color:#d8b4fe;background:rgba(168,85,247,.12)}
.tool-chip.ind-sr.active{border-color:#35d39a;color:#6ce6b5;background:rgba(53,211,154,.12)}
.tool-chip.ind-signals{border-color:#2b7a5b;color:#6ce6b5;background:rgba(18,56,41,.65)}
.tool-chip.ind-signals:hover{background:rgba(38,166,154,.25);color:#fff}
.tool-chip.ind-signals.active{background:linear-gradient(135deg,#186a52,#26a69a);color:#fff;border-color:#5eead4;box-shadow:0 0 14px rgba(38,166,154,.35)}

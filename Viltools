  /* =========================================================
     10B. MULTI-CHAIN PAPER TRADING ENGINE (MARKET, LIMIT, TP/SL, LEVERAGE)
     ========================================================= */
  const PAPER_STORAGE_KEY = 'viltools_paper_account_v1';
  const INITIAL_PAPER_CASH = 10000;

  let paperState = {
    cash: INITIAL_PAPER_CASH,
    positions: [],
    orders: [],
    history: []
  };

  let execMode = 'paper';
  let paperSide = 'long';
  let paperOrderType = 'market';
  let paperLeverage = 1;
  let paperChartLines = [];

  function loadPaperState() {
    try {
      const saved = JSON.parse(localStorage.getItem(PAPER_STORAGE_KEY) || 'null');
      if (saved && typeof saved === 'object') {
        paperState.cash = Number.isFinite(Number(saved.cash)) ? Number(saved.cash) : INITIAL_PAPER_CASH;
        paperState.positions = Array.isArray(saved.positions) ? saved.positions : [];
        paperState.orders = Array.isArray(saved.orders) ? saved.orders : [];
        paperState.history = Array.isArray(saved.history) ? saved.history : [];
      }
    } catch {}
  }

  function savePaperState() {
    try { localStorage.setItem(PAPER_STORAGE_KEY, JSON.stringify(paperState)); } catch {}
  }

  function calcPositionPnl(pos, currentPrice = pos.markPrice) {
    const px = Number(currentPrice || pos.entryPrice || 0);
    if (!(px > 0) || !(pos.entryPrice > 0)) return 0;
    const diff = pos.side === 'long' ? (px - pos.entryPrice) : (pos.entryPrice - px);
    return diff * pos.qty;
  }

  function calcLiqPrice(entryPrice, side, leverage) {
    if (leverage <= 1 || !(entryPrice > 0)) return 0;
    const buffer = 0.9 / leverage;
    return side === 'long' ? entryPrice * (1 - buffer) : entryPrice * (1 + buffer);
  }

  function getTotalPaperEquity() {
    let lockedMargin = 0;
    let unrealizedPnl = 0;
    for (const pos of paperState.positions) {
      lockedMargin += pos.margin;
      unrealizedPnl += calcPositionPnl(pos);
    }
    const pendingMargin = paperState.orders.reduce((s, o) => s + o.margin, 0);
    return {
      cash: paperState.cash,
      lockedMargin,
      pendingMargin,
      unrealizedPnl,
      equity: paperState.cash + lockedMargin + pendingMargin + unrealizedPnl
    };
  }

  function setExecutionMode(mode) {
    execMode = mode === 'live' ? 'live' : 'paper';
    const isPaper = execMode === 'paper';

    $('mode-tab-paper')?.classList.toggle('active-paper', isPaper);
    $('mode-tab-live')?.classList.toggle('active-live', !isPaper);
    if ($('paper-trade-box')) $('paper-trade-box').hidden = !isPaper;
    if ($('live-trade-box')) $('live-trade-box').hidden = isPaper;

    if ($('wallet-status-pill')) {
      $('wallet-status-pill').textContent = isPaper
        ? 'PAPER READY'
        : (connectedPublicKey ? 'WALLET CONNECTED' : 'WALLET DISCONNECTED');
    }
    updatePaperEstimate();
  }

  function updatePaperEstimate() {
    const margin = Number($('paper-amount')?.value || 0);
    const spotPx = Number(activeToken?.priceUsd || 0);
    const limitPx = Number($('paper-limit-price')?.value || 0);
    const refPx = (paperOrderType === 'limit' && limitPx > 0) ? limitPx : spotPx;
    const notional = margin * paperLeverage;
    const liqPx = refPx > 0 ? calcLiqPrice(refPx, paperSide, paperLeverage) : 0;

    if ($('paper-lev-val')) $('paper-lev-val').textContent = `${paperLeverage}x`;
    if ($('paper-est-notional')) $('paper-est-notional').textContent = money(notional);
    if ($('paper-est-liq')) $('paper-est-liq').textContent = liqPx > 0 ? price(liqPx) : 'None (1x Spot)';
    if ($('paper-est-tokens')) {
      $('paper-est-tokens').textContent = (refPx > 0 && notional > 0)
        ? `${fmt(notional / refPx, 4)} ${activeToken?.baseToken?.symbol || 'TOK'}`
        : '—';
    }

    if ($('paper-limit-diff') && spotPx > 0 && limitPx > 0) {
      const pct = ((limitPx - spotPx) / spotPx) * 100;
      $('paper-limit-diff').textContent = `(${pct >= 0 ? '+' : ''}${pct.toFixed(2)}% vs spot)`;
    } else if ($('paper-limit-diff')) {
      $('paper-limit-diff').textContent = '';
    }

    const btn = $('paper-submit-btn');
    if (btn) {
      const sym = activeToken?.baseToken?.symbol || 'Token';
      const actionLabel = paperOrderType === 'limit' ? 'Place Limit' : 'Paper';
      btn.textContent = paperSide === 'long'
        ? `${actionLabel} Buy / Long ${sym} (${paperLeverage}x) ↗`
        : `${actionLabel} Sell / Short ${sym} (${paperLeverage}x) ↘`;
      btn.style.background = paperSide === 'long'
        ? 'linear-gradient(135deg,#186a52,#26a69a)'
        : 'linear-gradient(135deg,#991b1b,#ef4444)';
    }
  }

  function renderPaperChartOverlays() {
    if (!mainSeries) return;
    for (const line of paperChartLines) {
      try { mainSeries.removePriceLine(line); } catch {}
    }
    paperChartLines = [];
    if (!activeToken?.baseToken?.address) return;

    const mint = activeToken.baseToken.address.toLowerCase();
    const tokenPositions = paperState.positions.filter(p => p.mint.toLowerCase() === mint);
    const tokenOrders = paperState.orders.filter(o => o.mint.toLowerCase() === mint);

    for (const pos of tokenPositions) {
      paperChartLines.push(mainSeries.createPriceLine({
        price: toDisplayValue(pos.entryPrice),
        color: pos.side === 'long' ? '#35d39a' : '#ff666f',
        lineWidth: 2,
        lineStyle: 0,
        axisLabelVisible: true,
        title: `PAPER ${pos.side.toUpperCase()} ${pos.leverage}x`
      }));
      if (pos.tp > 0) {
        paperChartLines.push(mainSeries.createPriceLine({
          price: toDisplayValue(pos.tp),
          color: '#26a69a',
          lineWidth: 1,
          lineStyle: 2,
          axisLabelVisible: true,
          title: 'TP'
        }));
      }
      if (pos.sl > 0) {
        paperChartLines.push(mainSeries.createPriceLine({
          price: toDisplayValue(pos.sl),
          color: '#fb923c',
          lineWidth: 1,
          lineStyle: 2,
          axisLabelVisible: true,
          title: 'SL'
        }));
      }
    }

    for (const ord of tokenOrders) {
      paperChartLines.push(mainSeries.createPriceLine({
        price: toDisplayValue(ord.triggerPrice),
        color: '#38bdf8',
        lineWidth: 1,
        lineStyle: 1,
        axisLabelVisible: true,
        title: `LIMIT ${ord.side.toUpperCase()}`
      }));
    }
  }

  function closePaperPosition(posId, exitPrice, reason = 'Manual Close') {
    const idx = paperState.positions.findIndex(p => p.id === posId);
    if (idx === -1) return;
    const pos = paperState.positions[idx];
    const finalExit = Number(exitPrice || pos.markPrice || pos.entryPrice);
    const rawPnl = calcPositionPnl(pos, finalExit);
    const settledPnl = Math.max(-pos.margin, rawPnl);
    const returnedCash = Math.max(0, pos.margin + settledPnl);

    paperState.cash += returnedCash;
    paperState.positions.splice(idx, 1);
    paperState.history.unshift({
      id: pos.id,
      chainId: pos.chainId,
      mint: pos.mint,
      symbol: pos.symbol,
      side: pos.side,
      leverage: pos.leverage,
      margin: pos.margin,
      entryPrice: pos.entryPrice,
      exitPrice: finalExit,
      pnl: settledPnl,
      reason,
      closedAt: Date.now()
    });
    paperState.history = paperState.history.slice(0, 100);
    savePaperState();
    renderAllPaperViews();
    renderPaperChartOverlays();
    toast(`${reason}: ${pos.symbol} closed (${settledPnl >= 0 ? '+' : ''}${money(settledPnl)})`);
  }

  function cancelPaperOrder(orderId) {
    const idx = paperState.orders.findIndex(o => o.id === orderId);
    if (idx === -1) return;
    const ord = paperState.orders[idx];
    paperState.cash += ord.margin;
    paperState.orders.splice(idx, 1);
    savePaperState();
    renderAllPaperViews();
    renderPaperChartOverlays();
    toast(`Canceled limit order on ${ord.symbol}.`);
  }

  function editPaperPositionTpSl(posId) {
    const pos = paperState.positions.find(p => p.id === posId);
    if (!pos) return;
    const nextTp = prompt(`Set Take-Profit USD price for ${pos.symbol} (leave blank to clear):`, pos.tp > 0 ? String(pos.tp) : '');
    if (nextTp === null) return;
    const nextSl = prompt(`Set Stop-Loss USD price for ${pos.symbol} (leave blank to clear):`, pos.sl > 0 ? String(pos.sl) : '');
    if (nextSl === null) return;
    pos.tp = Number(nextTp) > 0 ? Number(nextTp) : 0;
    pos.sl = Number(nextSl) > 0 ? Number(nextSl) : 0;
    savePaperState();
    renderAllPaperViews();
    renderPaperChartOverlays();
    toast(`Updated TP/SL for ${pos.symbol}.`);
  }

  function evaluatePaperTriggersForMint(mint, liveUsdPrice, chainId = '') {
    if (!mint || !(liveUsdPrice > 0)) return;
    const targetMint = mint.toLowerCase();
    let changed = false;

    for (let i = paperState.orders.length - 1; i >= 0; i--) {
      const ord = paperState.orders[i];
      if (ord.mint.toLowerCase() !== targetMint) continue;
      if (chainId && ord.chainId && ord.chainId.toLowerCase() !== chainId.toLowerCase()) continue;

      const hit = ord.side === 'long'
        ? liveUsdPrice <= ord.triggerPrice
        : liveUsdPrice >= ord.triggerPrice;

      if (hit) {
        paperState.orders.splice(i, 1);
        const fillPx = ord.triggerPrice;
        const notional = ord.margin * ord.leverage;
        paperState.positions.unshift({
          id: 'pos_' + Date.now() + '_' + Math.random().toString(36).slice(2, 6),
          chainId: ord.chainId,
          pairAddress: ord.pairAddress,
          mint: ord.mint,
          symbol: ord.symbol,
          name: ord.name,
          side: ord.side,
          leverage: ord.leverage,
          margin: ord.margin,
          notional,
          qty: notional / fillPx,
          entryPrice: fillPx,
          markPrice: liveUsdPrice,
          tp: ord.tp,
          sl: ord.sl,
          liqPrice: calcLiqPrice(fillPx, ord.side, ord.leverage),
          openedAt: Date.now()
        });
        changed = true;
        toast(`⚡ Limit Order Filled: ${ord.side.toUpperCase()} ${ord.symbol} @ ${price(fillPx)}`);
      }
    }

    for (let i = paperState.positions.length - 1; i >= 0; i--) {
      const pos = paperState.positions[i];
      if (pos.mint.toLowerCase() !== targetMint) continue;
      if (chainId && pos.chainId && pos.chainId.toLowerCase() !== chainId.toLowerCase()) continue;

      pos.markPrice = liveUsdPrice;
      changed = true;

      if (pos.liqPrice > 0) {
        const liquidated = pos.side === 'long' ? liveUsdPrice <= pos.liqPrice : liveUsdPrice >= pos.liqPrice;
        if (liquidated) {
          closePaperPosition(pos.id, pos.liqPrice, 'Liquidated');
          continue;
        }
      }
      if (pos.tp > 0) {
        const tpHit = pos.side === 'long' ? liveUsdPrice >= pos.tp : liveUsdPrice <= pos.tp;
        if (tpHit) {
          closePaperPosition(pos.id, pos.tp, 'Take Profit');
          continue;
        }
      }
      if (pos.sl > 0) {
        const slHit = pos.side === 'long' ? liveUsdPrice <= pos.sl : liveUsdPrice >= pos.sl;
        if (slHit) {
          closePaperPosition(pos.id, pos.sl, 'Stop Loss');
          continue;
        }
      }
    }

    if (changed) {
      savePaperState();
      renderAllPaperViews();
      if (activeToken?.baseToken?.address?.toLowerCase() === targetMint) renderPaperChartOverlays();
    }
  }

  function syncPaperPricesFromMarketFeed() {
    for (const p of pairs) {
      const px = Number(p.priceUsd || 0);
      if (px > 0 && p.baseToken?.address) {
        evaluatePaperTriggersForMint(p.baseToken.address, px, p.chainId);
      }
    }
  }

  function renderAllPaperViews() {
    const totals = getTotalPaperEquity();
    const totalCount = paperState.positions.length + paperState.orders.length;

    if ($('topbar-paper-bal')) $('topbar-paper-bal').textContent = money(totals.equity);
    if ($('paper-panel-cash')) $('paper-panel-cash').textContent = money(totals.cash);
    if ($('paper-panel-equity')) $('paper-panel-equity').textContent = money(totals.equity);
    if ($('paper-pos-tab-count')) $('paper-pos-tab-count').textContent = String(totalCount);

    const badge = $('nav-paper-count');
    if (badge) {
      badge.textContent = String(totalCount);
      badge.hidden = totalCount === 0;
    }

    const tokenListEl = $('paper-token-positions-list');
    if (tokenListEl) {
      const mint = activeToken?.baseToken?.address?.toLowerCase() || '';
      const tPos = mint ? paperState.positions.filter(p => p.mint.toLowerCase() === mint) : [];
      const tOrd = mint ? paperState.orders.filter(o => o.mint.toLowerCase() === mint) : [];

      if (!tPos.length && !tOrd.length) {
        tokenListEl.innerHTML = '<span class="muted">No open paper positions or limit orders on this coin yet.</span>';
      } else {
        const posCards = tPos.map(pos => {
          const pnl = calcPositionPnl(pos);
          const pnlPct = pos.margin > 0 ? (pnl / pos.margin) * 100 : 0;
          return `<div class="paper-pos-card">
            <div class="paper-pos-top">
              <span><span class="${pos.side === 'long' ? 'badge-long' : 'badge-short'}">${pos.side.toUpperCase()} ${pos.leverage}x</span> <b>${money(pos.margin)}</b></span>
              <b class="${pnl >= 0 ? 'positive' : 'negative'}">${pnl >= 0 ? '+' : ''}${money(pnl)} (${pnlPct >= 0 ? '+' : ''}${pnlPct.toFixed(1)}%)</b>
            </div>
            <div class="paper-pos-grid">
              <span>Entry: <b>${price(pos.entryPrice)}</b></span>
              <span>Mark: <b>${price(pos.markPrice)}</b></span>
              <span>TP: <b>${pos.tp > 0 ? price(pos.tp) : '—'}</b></span>
              <span>SL: <b>${pos.sl > 0 ? price(pos.sl) : '—'}</b></span>
            </div>
            <div class="paper-pos-actions">
              <button type="button" class="btn-edit-tpsl" data-edit-paper-pos="${esc(pos.id)}">Edit TP/SL</button>
              <button type="button" class="btn-close-pos" data-close-paper-pos="${esc(pos.id)}">Close Position</button>
            </div>
          </div>`;
        });

        const ordCards = tOrd.map(ord => `<div class="paper-pos-card">
          <div class="paper-pos-top">
            <span><span class="${ord.side === 'long' ? 'badge-long' : 'badge-short'}">LIMIT ${ord.side.toUpperCase()} ${ord.leverage}x</span> <b>${money(ord.margin)}</b></span>
            <button type="button" class="btn-close-pos" style="padding:3px 7px;font-size:8.5px" data-cancel-paper-ord="${esc(ord.id)}">Cancel</button>
          </div>
          <div class="paper-pos-grid">
            <span>Trigger: <b>${price(ord.triggerPrice)}</b></span>
            <span>TP/SL: <b>${ord.tp > 0 ? price(ord.tp) : '—'} / ${ord.sl > 0 ? price(ord.sl) : '—'}</b></span>
          </div>
        </div>`);

        tokenListEl.innerHTML = [...posCards, ...ordCards].join('');
      }
    }

    const retPct = ((totals.equity - INITIAL_PAPER_CASH) / INITIAL_PAPER_CASH) * 100;
    const realizedPnl = paperState.history.reduce((s, h) => s + Number(h.pnl || 0), 0);
    const wins = paperState.history.filter(h => Number(h.pnl || 0) > 0).length;
    const winRate = paperState.history.length ? ((wins / paperState.history.length) * 100).toFixed(0) + '% win rate' : '0 closed trades';

    if ($('pp-stat-equity')) $('pp-stat-equity').textContent = money(totals.equity);
    if ($('pp-stat-return')) {
      $('pp-stat-return').textContent = `${retPct >= 0 ? '+' : ''}${retPct.toFixed(2)}% vs $10K start`;
      $('pp-stat-return').className = retPct >= 0 ? 'positive' : 'negative';
    }
    if ($('pp-stat-cash')) $('pp-stat-cash').textContent = money(totals.cash);
    if ($('pp-stat-locked')) $('pp-stat-locked').textContent = `${money(totals.lockedMargin + totals.pendingMargin)} in margin/orders`;
    if ($('pp-stat-upnl')) {
      $('pp-stat-upnl').textContent = `${totals.unrealizedPnl >= 0 ? '+' : ''}${money(totals.unrealizedPnl)}`;
      $('pp-stat-upnl').className = totals.unrealizedPnl >= 0 ? 'positive' : 'negative';
    }
    if ($('pp-stat-open-count')) $('pp-stat-open-count').textContent = `${paperState.positions.length} open position(s)`;
    if ($('pp-stat-rpnl')) {
      $('pp-stat-rpnl').textContent = `${realizedPnl >= 0 ? '+' : ''}${money(realizedPnl)}`;
      $('pp-stat-rpnl').className = realizedPnl >= 0 ? 'positive' : 'negative';
    }
    if ($('pp-stat-winrate')) $('pp-stat-winrate').textContent = `${paperState.history.length} trades · ${winRate}`;

    if ($('pp-positions-table')) {
      $('pp-positions-table').innerHTML = paperState.positions.map(pos => {
        const pnl = calcPositionPnl(pos);
        const pnlPct = pos.margin > 0 ? (pnl / pos.margin) * 100 : 0;
        return `<tr class="token-row" data-row-token="${esc(pos.mint)}" data-row-chain="${esc(pos.chainId)}" data-row-pair="${esc(pos.pairAddress || '')}">
          <td><b>${esc(pos.symbol)}</b> <span class="chain-tag">${esc(chainName(pos.chainId))}</span></td>
          <td><span class="${pos.side === 'long' ? 'badge-long' : 'badge-short'}">${pos.side.toUpperCase()} ${pos.leverage}x</span></td>
          <td>${money(pos.margin)} <span class="muted">(${money(pos.notional)})</span></td>
          <td>${price(pos.entryPrice)}</td>
          <td>${price(pos.markPrice)}</td>
          <td>${pos.tp > 0 ? price(pos.tp) : '—'} / ${pos.sl > 0 ? price(pos.sl) : '—'} / ${pos.liqPrice > 0 ? price(pos.liqPrice) : '—'}</td>
          <td class="${pnl >= 0 ? 'positive' : 'negative'}"><b>${pnl >= 0 ? '+' : ''}${money(pnl)}</b> (${pnlPct >= 0 ? '+' : ''}${pnlPct.toFixed(1)}%)</td>
          <td>
            <button type="button" class="outline-btn" style="padding:5px 8px" data-edit-paper-pos="${esc(pos.id)}">TP/SL</button>
            <button type="button" class="open-token" style="border-color:#7c2b35;background:#3a1419;color:#ff858b" data-close-paper-pos="${esc(pos.id)}">Close</button>
          </td>
        </tr>`;
      }).join('') || '<tr><td colspan="8" class="empty">No open paper positions yet. Open any token on the website and click Paper Trade!</td></tr>';
    }

    if ($('pp-orders-table')) {
      $('pp-orders-table').innerHTML = paperState.orders.map(ord => {
        const livePair = pairs.find(x => x.baseToken?.address?.toLowerCase() === ord.mint.toLowerCase());
        const curPx = livePair?.priceUsd || 0;
        return `<tr>
          <td><b>${esc(ord.symbol)}</b> <span class="chain-tag">${esc(chainName(ord.chainId))}</span></td>
          <td><span class="${ord.side === 'long' ? 'badge-long' : 'badge-short'}">${ord.side.toUpperCase()} ${ord.leverage}x</span></td>
          <td>${money(ord.margin)}</td>
          <td><b>${price(ord.triggerPrice)}</b></td>
          <td>${curPx > 0 ? price(curPx) : '—'}</td>
          <td>${ord.tp > 0 ? price(ord.tp) : '—'} / ${ord.sl > 0 ? price(ord.sl) : '—'}</td>
          <td class="muted">${new Date(ord.createdAt).toLocaleTimeString()}</td>
          <td><button type="button" class="open-token" style="border-color:#7c2b35;background:#3a1419;color:#ff858b" data-cancel-paper-ord="${esc(ord.id)}">Cancel</button></td>
        </tr>`;
      }).join('') || '<tr><td colspan="8" class="empty">No pending limit orders.</td></tr>';
    }

    if ($('pp-history-table')) {
      $('pp-history-table').innerHTML = paperState.history.map(h => `<tr>
        <td><b>${esc(h.symbol)}</b> <span class="chain-tag">${esc(chainName(h.chainId))}</span></td>
        <td><span class="${h.side === 'long' ? 'badge-long' : 'badge-short'}">${h.side.toUpperCase()} ${h.leverage}x</span></td>
        <td>${money(h.margin)}</td>
        <td>${price(h.entryPrice)} → ${price(h.exitPrice)}</td>
        <td><span class="flag ${h.pnl >= 0 ? 'ok' : ''}">${esc(h.reason)}</span></td>
        <td class="${h.pnl >= 0 ? 'positive' : 'negative'}"><b>${h.pnl >= 0 ? '+' : ''}${money(h.pnl)}</b></td>
        <td class="muted">${new Date(h.closedAt).toLocaleTimeString()}</td>
      </tr>`).join('') || '<tr><td colspan="7" class="empty">No closed paper trades yet.</td></tr>';
    }
  }

  function initPaperTrading() {
    loadPaperState();
    setExecutionMode('paper');
    renderAllPaperViews();

    $('topbar-paper-btn')?.addEventListener('click', () => nav('paper'));

    document.querySelectorAll('[data-exec-mode]').forEach(btn => {
      btn.addEventListener('click', () => setExecutionMode(btn.dataset.execMode));
    });

    document.querySelectorAll('[data-paper-side]').forEach(btn => {
      btn.addEventListener('click', () => {
        paperSide = btn.dataset.paperSide;
        $('paper-side-long')?.classList.toggle('active-long', paperSide === 'long');
        $('paper-side-short')?.classList.toggle('active-short', paperSide === 'short');
        updatePaperEstimate();
      });
    });

    document.querySelectorAll('[data-paper-order-type]').forEach(btn => {
      btn.addEventListener('click', () => {
        paperOrderType = btn.dataset.paperOrderType;
        document.querySelectorAll('[data-paper-order-type]').forEach(x => x.classList.toggle('active', x === btn));
        const isPosTab = paperOrderType === 'positions';
        if ($('paper-order-form')) $('paper-order-form').hidden = isPosTab;
        if ($('paper-limit-wrap')) $('paper-limit-wrap').hidden = paperOrderType !== 'limit';
        if (paperOrderType === 'limit' && activeToken?.priceUsd && !$('paper-limit-price')?.value) {
          const spot = Number(activeToken.priceUsd);
          $('paper-limit-price').value = (paperSide === 'long' ? spot * 0.95 : spot * 1.05).toPrecision(5);
        }
        updatePaperEstimate();
      });
    });

    document.querySelectorAll('[data-plev]').forEach(btn => {
      btn.addEventListener('click', () => {
        paperLeverage = Number(btn.dataset.plev || 1);
        document.querySelectorAll('[data-plev]').forEach(x => x.classList.toggle('active', x === btn));
        updatePaperEstimate();
      });
    });

    document.querySelectorAll('#paper-quick-amounts button').forEach(btn => {
      btn.addEventListener('click', () => {
        const val = btn.dataset.pamt;
        $('paper-amount').value = val === 'max' ? Math.max(10, Math.floor(paperState.cash * 0.25)) : val;
        updatePaperEstimate();
      });
    });

    ['paper-amount', 'paper-limit-price', 'paper-tp-price', 'paper-sl-price'].forEach(id => {
      $(id)?.addEventListener('input', updatePaperEstimate);
    });

    $('paper-submit-btn')?.addEventListener('click', () => {
      if (!activeToken?.baseToken?.address) { toast('Open any token first to paper trade it.'); return; }
      const spotPx = Number(activeToken.priceUsd || 0);
      if (!(spotPx > 0)) { toast('Waiting for live token price…'); return; }

      const margin = Number($('paper-amount')?.value || 0);
      if (!(margin >= 1)) { toast('Enter a valid USD margin amount.'); return; }
      if (margin > paperState.cash) { toast(`Insufficient paper cash (${money(paperState.cash)} available).`); return; }

      const tp = Number($('paper-tp-price')?.value || 0);
      const sl = Number($('paper-sl-price')?.value || 0);
      const mint = activeToken.baseToken.address;
      const symbol = activeToken.baseToken.symbol || 'TOKEN';
      const name = activeToken.baseToken.name || symbol;

      if (paperOrderType === 'limit') {
        const triggerPrice = Number($('paper-limit-price')?.value || 0);
        if (!(triggerPrice > 0)) { toast('Enter a valid Limit trigger price.'); return; }
        paperState.cash -= margin;
        paperState.orders.unshift({
          id: 'ord_' + Date.now() + '_' + Math.random().toString(36).slice(2, 6),
          chainId: activeToken.chainId || 'solana',
          pairAddress: activeToken.pairAddress || '',
          mint, symbol, name,
          side: paperSide,
          leverage: paperLeverage,
          margin,
          triggerPrice,
          tp: tp > 0 ? tp : 0,
          sl: sl > 0 ? sl : 0,
          createdAt: Date.now()
        });
        savePaperState();
        renderAllPaperViews();
        renderPaperChartOverlays();
        toast(`Limit ${paperSide.toUpperCase()} placed on ${symbol} @ ${price(triggerPrice)}`);
        return;
      }

      const slipMult = paperSide === 'long' ? 1.0035 : 0.9965;
      const fillPrice = spotPx * slipMult;
      const notional = margin * paperLeverage;

      paperState.cash -= margin;
      paperState.positions.unshift({
        id: 'pos_' + Date.now() + '_' + Math.random().toString(36).slice(2, 6),
        chainId: activeToken.chainId || 'solana',
        pairAddress: activeToken.pairAddress || '',
        mint, symbol, name,
        side: paperSide,
        leverage: paperLeverage,
        margin,
        notional,
        qty: notional / fillPrice,
        entryPrice: fillPrice,
        markPrice: spotPx,
        tp: tp > 0 ? tp : 0,
        sl: sl > 0 ? sl : 0,
        liqPrice: calcLiqPrice(fillPrice, paperSide, paperLeverage),
        openedAt: Date.now()
      });

      savePaperState();
      renderAllPaperViews();
      renderPaperChartOverlays();
      toast(`Paper ${paperSide.toUpperCase()} opened: ${symbol} (${paperLeverage}x) @ ${price(fillPrice)}`);
    });

    document.addEventListener('click', e => {
      const closeBtn = e.target.closest('[data-close-paper-pos]');
      if (closeBtn) {
        e.stopPropagation();
        const pos = paperState.positions.find(p => p.id === closeBtn.dataset.closePaperPos);
        if (pos) closePaperPosition(pos.id, pos.markPrice, 'Manual Close');
        return;
      }
      const editBtn = e.target.closest('[data-edit-paper-pos]');
      if (editBtn) {
        e.stopPropagation();
        editPaperPositionTpSl(editBtn.dataset.editPaperPos);
        return;
      }
      const cancelBtn = e.target.closest('[data-cancel-paper-ord]');
      if (cancelBtn) {
        e.stopPropagation();
        cancelPaperOrder(cancelBtn.dataset.cancelPaperOrd);
      }
    });

    $('pp-topup-btn')?.addEventListener('click', () => {
      paperState.cash += 5000;
      savePaperState();
      renderAllPaperViews();
      toast('Added $5,000.00 paper funds.');
    });

    $('pp-refresh-prices-btn')?.addEventListener('click', () => {
      loadMarket(true);
      syncPaperPricesFromMarketFeed();
    });

    $('pp-reset-btn')?.addEventListener('click', () => {
      if (!confirm('Reset paper account back to $10,000.00 and clear all open positions & history?')) return;
      paperState = { cash: INITIAL_PAPER_CASH, positions: [], orders: [], history: [] };
      savePaperState();
      renderAllPaperViews();
      renderPaperChartOverlays();
      toast('Paper trading account reset to $10,000.00.');
    });
  }

  /* =========================================================
     11. BOOT SEQUENCE
     ========================================================= */
  GalaxyEngine.init();
  initPaperTrading();
  loadAppearance();
  walletUi();
  scheduleRefresh();
  connectPumpStream();
  loadMarket(false);
})();
</script>
</body>

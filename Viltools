  async function resolveTokenDecimals(mint) {
    if (mint === SOL_MINT) return 9;
    const supply = await solanaRpc('getTokenSupply', [mint]);
    const dec = Number(supply?.value?.decimals);
    if (!Number.isInteger(dec)) throw new Error('Unable to read token decimals.');
    return dec;
  }

  function scheduleQuotePreview() {
    clearTimeout(quoteDebounceTimer);
    if ($('swap-impact-val')) $('swap-impact-val').textContent = '—';
    if ($('swap-route-val')) $('swap-route-val').textContent = 'Jupiter Ultra / Metis';


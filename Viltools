  function computeEMA(bars, period) {
    if (!bars.length) return [];
    const k = 2 / (period + 1);
    let ema = bars[0].close;
    return bars.map((b, idx) => {
      ema = idx === 0 ? b.close : b.close * k + ema * (1 - k);
      return { time: b.time, value: ema };
    });
  }

  function computeVWAP(bars) {
    let cumPV = 0;
    let cumVol = 0;
    return bars.map(b => {
      const typical = (b.high + b.low + b.close) / 3;
      const vol = b.volume > 0 ? b.volume : 1;
      cumPV += typical * vol;
      cumVol += vol;
      return { time: b.time, value: cumVol > 0 ? cumPV / cumVol : typical };
    });
  }

  function computeBollinger(bars, period = 20, mult = 2) {
    const upper = [];
    const lower = [];
    for (let i = 0; i < bars.length; i++) {
      const start = Math.max(0, i - period + 1);
      const slice = bars.slice(start, i + 1);
      const mean = slice.reduce((s, x) => s + x.close, 0) / slice.length;
      const variance = slice.reduce((s, x) => s + Math.pow(x.close - mean, 2), 0) / slice.length;
      const std = Math.sqrt(variance);
      upper.push({ time: bars[i].time, value: mean + mult * std });
      lower.push({ time: bars[i].time, value: Math.max(0.00000000001, mean - mult * std) });
    }
    return { upper, lower };
  }


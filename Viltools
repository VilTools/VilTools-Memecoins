  /* =========================================================
     4. MARKET DATA FETCHING & AUTO-REFRESH
     ========================================================= */
  async function fetchJson(url, options = {}) {
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), options.timeout || 14000);
    try {
      const response = await fetch(url, {
        ...options,
        signal: controller.signal,
        headers: { 'Accept': 'application/json;version=20230203', ...(options.headers || {}) }
      });
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      return await response.json();
    } catch (e) {
      if (e.name === 'AbortError') throw new Error('Request timed out');
      throw e;
    } finally {
      clearTimeout(timeout);
    }
  }

  async function getSolUsdPrice() {
    if (cachedSolUsdPrice > 0) return cachedSolUsdPrice;
    try {
      const res = await fetchJson(`${API}/latest/dex/tokens/${SOL_MINT}`, { timeout: 6000 });
      const p = (res?.pairs || []).find(x => x.quoteToken?.symbol?.includes('USD'));
      const px = Number(p?.priceUsd || 0);
      if (px > 0) cachedSolUsdPrice = px;
    } catch {}
    return cachedSolUsdPrice;
  }

  function setHealth(kind, message, detail = '') {
    const el = $('data-health');
    if (!el) return;
    el.classList.remove('ok', 'bad');
    if (kind === 'ok') el.classList.add('ok');
    if (kind === 'bad') el.classList.add('bad');
    const label = kind === 'ok' ? 'Connected' : kind === 'bad' ? 'Unavailable' : 'Updating';
    el.innerHTML = `<span class="health-dot"></span><b>Market data: ${label}</b> ${esc(message)} <span id="data-health-detail">${esc(detail)}</span>`;
  }

  function mergePairs(incomingList) {
    const map = new Map(pairs.map(p => [`${p.chainId}:${p.pairAddress}`.toLowerCase(), p]));
    let addedCount = 0;
    for (const pair of incomingList) {
      if (!pair?.pairAddress || !pair?.baseToken?.address) continue;
      const key = `${pair.chainId}:${pair.pairAddress}`.toLowerCase();
      if (!map.has(key)) addedCount++;
      map.set(key, pair);
    }
    pairs = [...map.values()].sort((a, b) => {
      const timeDiff = Number(b.pairCreatedAt || 0) - Number(a.pairCreatedAt || 0);
      if (Math.abs(timeDiff) > 3600000) return timeDiff;
      return Number(b.volume?.h24 || 0) - Number(a.volume?.h24 || 0);
    });
    return addedCount;
  }

  async function loadMarket(manual = false) {
    if (marketRefreshPromise) return marketRefreshPromise;
    const generation = ++marketRequestGeneration;

    marketRefreshPromise = (async () => {
      setHealth('loading', 'Scanning latest DexScreener & GeckoTerminal pairs…', 'Discovering new tokens and updating prices.');
      $('connection-label').textContent = 'Refreshing…';

      try {
        const nets = ['solana', 'ethereum', 'base', 'bsc'];
        const [profRes, boostRes, ...geckoRes] = await Promise.allSettled([
          fetchJson(`${API}/token-profiles/latest/v1`),
          fetchJson(`${API}/token-boosts/latest/v1`),
          ...nets.flatMap(net => [
            fetchJson(`${GECKO_API}/networks/${chainToGecko[net]}/new_pools?page=1`).then(d => ({ net, rows: d.data || [] })),
            fetchJson(`${GECKO_API}/networks/${chainToGecko[net]}/trending_pools?page=1`).then(d => ({ net, rows: d.data || [] }))
          ])
        ]);

        const profileRows = profRes.status === 'fulfilled' && Array.isArray(profRes.value) ? profRes.value : [];
        const boostRows = boostRes.status === 'fulfilled' && Array.isArray(boostRes.value) ? boostRes.value : [];

        const candidates = new Map();
        for (const item of [...profileRows, ...boostRows]) {
          if (item?.chainId && item?.tokenAddress) {
            candidates.set(`${item.chainId}:${item.tokenAddress}`.toLowerCase(), {
              chainId: item.chainId,
              tokenAddress: item.tokenAddress
            });
          }
        }

        for (const res of geckoRes) {
          if (res.status !== 'fulfilled') continue;
          const { net, rows } = res.value;
          for (const pool of rows.slice(0, 25)) {
            const rawId = pool.relationships?.base_token?.data?.id || pool.attributes?.base_token_address || '';
            const addr = String(rawId).replace(/^[^_]+_/, '');
            if (addr) {
              candidates.set(`${net}:${addr}`.toLowerCase(), {
                chainId: geckoToDex[net] || net,
                tokenAddress: addr
              });
            }
          }
        }

        const addresses = [...candidates.values()].slice(0, 96);
        const fetchedPairs = [];
        for (let i = 0; i < addresses.length; i += 16) {
          const chunk = addresses.slice(i, i + 16);
          const batch = await Promise.allSettled(
            chunk.map(x => fetchJson(`${API}/token-pairs/v1/${encodeURIComponent(x.chainId)}/${encodeURIComponent(x.tokenAddress)}`))
          );
          for (const r of batch) {
            if (r.status === 'fulfilled' && Array.isArray(r.value)) fetchedPairs.push(...r.value);
          }
          if (i + 16 < addresses.length) await sleep(80);
        }

        if (generation !== marketRequestGeneration) return;

        const newlyAdded = mergePairs(fetchedPairs);
        if (!pairs.length) throw new Error('No trading pairs returned from public endpoints.');

        if (profileRows.length) profiles = profileRows;
        marketLastSuccess = Date.now();
        try {
          sessionStorage.setItem(marketCacheKey, JSON.stringify({ at: marketLastSuccess, pairs: pairs.slice(0, 350), profiles }));
        } catch {}

        $('connection-label').textContent = 'Connected · live feed';
        setHealth(
          'ok',
          `${pairs.length.toLocaleString()} pairs active · Updated ${new Date(marketLastSuccess).toLocaleTimeString()}`,
          newlyAdded > 0 ? `+${newlyAdded} new coins added this scan.` : 'Prices & liquidity synchronized.'
        );
        renderAll();
        if (manual) toast(newlyAdded > 0 ? `Refreshed: +${newlyAdded} new pairs found!` : 'Market data refreshed.');
      } catch (err) {
        if (!pairs.length) {
          try {
            const cached = JSON.parse(sessionStorage.getItem(marketCacheKey) || 'null');
            if (cached?.pairs?.length) {
              pairs = cached.pairs;
              profiles = cached.profiles || [];
              renderAll();
              setHealth('bad', 'Showing cached market data', `Live refresh failed: ${err.message}`);
            }
          } catch {}
        }
        if (!pairs.length) {
          $('coin-table').innerHTML = `<tr><td colspan="8" class="empty-state">Market data unavailable: ${esc(err.message)}</td></tr>`;
          setHealth('bad', err.message, 'Click refresh to retry.');
        } else {
          setHealth('bad', 'Refresh failed; showing latest loaded pairs.', err.message);
        }
        $('connection-label').textContent = 'Retry scheduled';
      }
    })().finally(() => { marketRefreshPromise = null; });

    return marketRefreshPromise;
  }

  function scheduleRefresh() {
    clearInterval(refreshTimer);
    if ($('auto-refresh')?.checked) {
      const sec = Math.max(10, Number($('refresh-interval')?.value || 15));
      refreshTimer = setInterval(() => { if (!document.hidden) loadMarket(false); }, sec * 1000);
    }
  }

  $('auto-refresh')?.addEventListener('change', scheduleRefresh);
  $('refresh-interval')?.addEventListener('change', scheduleRefresh);
  $('refresh-btn')?.addEventListener('click', () => loadMarket(true));
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden && $('auto-refresh')?.checked && Date.now() - marketLastSuccess > 25000) loadMarket(false);
  });

  /* =========================================================
     5. SCORING, RENDERING & TABLES
     ========================================================= */
  function momentum(p) {
    const ch = Number(p.priceChange?.h24 || 0);
    const v = Number(p.volume?.h24 || 0);
    const l = Number(p.liquidity?.usd || 0);
    const t = txns(p) || 0;
    const score = 35 + Math.max(-25, Math.min(30, ch * 0.6)) + Math.min(20, l ? (v / l) * 8 : 0) + Math.min(15, t / 30);
    return Math.max(0, Math.min(100, Math.round(score)));
  }

  function lowCapScore(p) {
    const cap = Number(p.fdv || p.marketCap || 0);
    const liq = Number(p.liquidity?.usd || 0);
    const vol = Number(p.volume?.h24 || 0);
    const chg = Number(p.priceChange?.h24 || 0);
    const tr = txns(p) || 0;
    if (!cap || cap > 5000000 || liq < 3000 || vol < 500) return -1;
    return Math.max(0, Math.min(100, Math.round(
      Math.min(40, Math.max(0, chg) * 0.45) +
      Math.min(25, (vol / Math.max(liq, 1)) * 5) +
      Math.min(20, tr / 25) +
      Math.min(15, Math.max(0, 1 - cap / 5000000) * 15)
    )));
  }

  function riskFlags(p) {
    const f = [];
    const l = p.liquidity?.usd;
    const t = txns(p);
    const created = p.pairCreatedAt;
    if (l == null) f.push('Liquidity unknown');
    else if (l < 10000) f.push('Thin liquidity');
    if (created && Date.now() - created < 86400000) f.push('Pair under 24h');
    if (t != null && t < 20) f.push('Low 24h activity');
    if (t == null) f.push('Transactions unknown');
    if (p.priceUsd == null) f.push('Price unavailable');
    return f;
  }

  function assetCell(p) {
    const base = p.baseToken || {};
    return `<div class="asset-cell">
      <div class="asset-avatar">${esc((base.symbol || '?').slice(0, 2).toUpperCase())}</div>
      <div>
        <div class="asset-name">${esc(base.name || 'Unknown token')}</div>
        <div class="asset-symbol">${esc(base.symbol || '—')} · ${esc((p.dexId || 'DEX').toUpperCase())}</div>
      </div>
    </div>`;
  }

  function rowAttrs(p) {
    return `class="token-row" tabindex="0" data-row-token="${esc(p.baseToken?.address || '')}" data-row-chain="${esc(p.chainId || '')}" data-row-pair="${esc(p.pairAddress || '')}"`;
  }

  function buildRow(p, mode = 'home') {
    const ch = p.priceChange?.h24;
    const vol = p.volume?.h24;
    const liq = p.liquidity?.usd;
    const ageText = age(p.pairCreatedAt);
    const t = txns(p);
    const btn = `<button class="open-token" type="button" data-token="${esc(p.baseToken?.address || '')}" data-chain="${esc(p.chainId || '')}" data-pair="${esc(p.pairAddress || '')}">Open chart ↗</button>`;

    if (mode === 'prediction') {
      const m = momentum(p);
      return `<tr ${rowAttrs(p)}>
        <td>${assetCell(p)}</td>
        <td class="${ch >= 0 ? 'positive' : 'negative'}">${ch == null ? '—' : (ch > 0 ? '+' : '') + fmt(ch, 2) + '%'}</td>
        <td>${liq && vol ? fmt(vol / liq, 2) + 'x' : '—'}</td>
        <td>${t == null ? '—' : fmt(t, 0)}</td>
        <td><b>${m}/100</b></td>
        <td>${m >= 70 ? '<span class="positive">Strong activity</span>' : m >= 40 ? '<span class="muted">Mixed</span>' : '<span class="negative">Weak / unclear</span>'}</td>
        <td>${btn}</td>
      </tr>`;
    }

    if (mode === 'risk') {
      return `<tr ${rowAttrs(p)}>
        <td>${assetCell(p)}</td>
        <td>${money(liq)}</td>
        <td>${ageText}</td>
        <td>${t == null ? '—' : fmt(t, 0)}</td>
        <td>${riskFlags(p).map(x => `<span class="flag">${esc(x)}</span>`).join(' ') || '<span class="flag ok">No basic flags</span>'}</td>
        <td>${btn}</td>
      </tr>`;
    }

    return `<tr ${rowAttrs(p)}>
      <td>${assetCell(p)}</td>
      <td><span class="chain-tag">${esc(chainName(p.chainId))}</span></td>
      <td>${price(p.priceUsd)}</td>
      <td class="${ch == null ? 'muted' : ch >= 0 ? 'positive' : 'negative'}">${ch == null ? '—' : (ch > 0 ? '+' : '') + fmt(ch, 2) + '%'}</td>
      <td>${money(liq)}</td>
      <td>${money(vol)}</td>
      <td>${ageText}</td>
      <td>${btn}</td>
    </tr>`;
  }

  function renderAll() {
    const homeList = pairs.filter(p => feedFilter === 'all' || String(p.chainId).toLowerCase() === feedFilter);
    $('coin-table').innerHTML = homeList.slice(0, 60).map(p => buildRow(p, 'home')).join('') || '<tr><td colspan="8" class="empty">No matching pairs returned.</td></tr>';
    $('feed-count').textContent = `${homeList.length} pairs loaded`;
    $('stat-tokens').textContent = profiles.length ? fmt(profiles.length, 0) : fmt(pairs.length, 0);
    $('stat-pairs').textContent = fmt(pairs.length, 0);
    $('stat-active').textContent = fmt(pairs.filter(p => momentum(p) >= 65).length, 0);
    $('stat-risk').textContent = fmt(pairs.filter(p => riskFlags(p).length).length, 0);
    $('updated-label').textContent = 'Updated ' + new Date().toLocaleTimeString();

    renderPredictions();
    $('risk-table').innerHTML = pairs
      .filter(p => riskFlags(p).length)
      .sort((a, b) => riskFlags(b).length - riskFlags(a).length)
      .slice(0, 50)
      .map(p => buildRow(p, 'risk'))
      .join('') || '<tr><td colspan="6" class="empty">No flagged pairs in the returned data.</td></tr>';

    renderCatalog();
    renderSidePanel();
    syncPaperPricesFromMarketFeed();
    renderAllPaperViews();
  }

  function renderPredictions() {
    const mode = $('prediction-sort')?.value || 'newest';
    const sorted = [...pairs].sort((a, b) => {
      if (mode === 'momentum') return momentum(b) - momentum(a);
      if (mode === 'lowcap') return lowCapScore(b) - lowCapScore(a);
      return Number(b.pairCreatedAt || 0) - Number(a.pairCreatedAt || 0);
    });
    $('prediction-table').innerHTML = sorted.slice(0, 120).map(p => buildRow(p, 'prediction')).join('') || '<tr><td colspan="7" class="empty">No discovered pairs yet.</td></tr>';
  }

  $('prediction-sort')?.addEventListener('change', renderPredictions);

  document.querySelectorAll('[data-feed]').forEach(b => {
    b.addEventListener('click', () => {
      feedFilter = b.dataset.feed;
      document.querySelectorAll('[data-feed]').forEach(x => x.classList.toggle('active', x === b));
      renderAll();
    });
  });

  function renderCatalog() {
    if (!$('catalog-table')) return;
    const c = $('catalog-chain')?.value || 'all';
    const mc = Number($('catalog-mcap')?.value || 0);
    const l = Number($('catalog-liq')?.value || 0);
    const v = Number($('catalog-vol')?.value || 0);
    const sort = $('catalog-sort')?.value || 'score';

    let list = pairs.filter(p =>
      (c === 'all' || String(p.chainId).toLowerCase() === c) &&
      Number(p.fdv || p.marketCap || 0) >= mc &&
      Number(p.liquidity?.usd || 0) >= l &&
      Number(p.volume?.h24 || 0) >= v
    );

    if (sort === 'lowcap') {
      list = list.filter(p => lowCapScore(p) >= 0).sort((a, b) => lowCapScore(b) - lowCapScore(a));
    } else {
      const keyFn = {
        score: p => momentum(p),
        newest: p => Number(p.pairCreatedAt || 0),
        marketcap: p => Number(p.fdv || p.marketCap || 0),
        liquidity: p => Number(p.liquidity?.usd || 0),
        volume: p => Number(p.volume?.h24 || 0),
        change: p => Number(p.priceChange?.h24 || 0)
      }[sort] || (p => momentum(p));
      list.sort((a, b) => keyFn(b) - keyFn(a));
    }

    const pages = Math.max(1, Math.ceil(list.length / 100));
    catalogPage = Math.min(catalogPage, pages - 1);
    const rows = list.slice(catalogPage * 100, (catalogPage + 1) * 100);

    $('catalog-table').innerHTML = rows.map(p => {
      const scoreVal = sort === 'lowcap' ? lowCapScore(p) : momentum(p);
      return `<tr ${rowAttrs(p)}>
        <td>${assetCell(p)}${lowCapScore(p) >= 55 ? '<span class="lowcap-tag">LOW CAP</span>' : ''}</td>
        <td><span class="chain-tag">${esc(chainName(p.chainId))}</span></td>
        <td>${price(p.priceUsd)}</td>
        <td class="${(p.priceChange?.h24 || 0) >= 0 ? 'positive' : 'negative'}">${fmt(p.priceChange?.h24, 2)}%</td>
        <td>${money(p.fdv || p.marketCap)}</td>
        <td>${money(p.liquidity?.usd)}</td>
        <td>${money(p.volume?.h24)}</td>
        <td><b>${scoreVal}/100</b></td>
        <td><button class="open-token" type="button" data-token="${esc(p.baseToken?.address || '')}" data-chain="${esc(p.chainId || '')}" data-pair="${esc(p.pairAddress || '')}">Open chart ↗</button></td>
      </tr>`;
    }).join('') || '<tr><td colspan="9" class="empty">No tokens match these filters.</td></tr>';

    $('catalog-count').textContent = `${list.length.toLocaleString()} matching pairs · 100 per page`;

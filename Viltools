  function startLiveCandleStream(p, net, poolAddr, generation) {
    clearInterval(liveChartTimer);
    let pollInFlight = false;
    let lastDexRefresh = 0;
    let lastJupRefresh = 0;
    let lastTradeRefresh = 0;
    let latestKnownPrice = Number(p.priceUsd || (rawBaseCandles[rawBaseCandles.length - 1]?.close ?? 0));

    const getStepSec = () => ({ s1: 1, s5: 5, s15: 15, live: 60, hour: 300, day: 3600, week: 86400 })[timeframe] || 60;

    const updateHudAndClock = () => {
      if (generation !== candleLoadGeneration || !mainSeries || !rawBaseCandles.length) return;
      const stepSec = getStepSec();
      const nowMs = Date.now();
      const nowSec = Math.floor(nowMs / 1000);
      const bucketSec = Math.floor(nowSec / stepSec) * stepSec;
      const lastRaw = rawBaseCandles[rawBaseCandles.length - 1];
      const activePx = latestKnownPrice > 0 ? latestKnownPrice : lastRaw.close;

      if (bucketSec > lastRaw.time && activePx > 0) {
        const nextRaw = {
          time: bucketSec,
          open: lastRaw.close,
          high: Math.max(lastRaw.close, activePx),
          low: Math.min(lastRaw.close, activePx),
          close: activePx,
          volume: 0
        };
        rawBaseCandles.push(nextRaw);
        if (rawBaseCandles.length > 500) rawBaseCandles.shift();

        const nextDisp = {
          time: bucketSec,
          open: toDisplayValue(nextRaw.open),
          high: toDisplayValue(nextRaw.high),
          low: toDisplayValue(nextRaw.low),
          close: toDisplayValue(nextRaw.close),
          volume: 0
        };
        liveCandlesList.push(nextDisp);
        if (liveCandlesList.length > 500) liveCandlesList.shift();

        if (chartStyle === 'area') mainSeries.update({ time: bucketSec, value: nextDisp.close });
        else mainSeries.update(nextDisp);

        if (volumeSeries) {
          volumeSeries.update({ time: bucketSec, value: 0, color: 'rgba(168,150,153,.18)' });
        }
        syncTechnicalOverlays();
        renderDrawingsOverlay();
      }

      const hudPrice = $('hud-live-price');
      const hudTimer = $('hud-candle-timer');
      const hudMode = $('hud-feed-mode');
      if (hudPrice && activePx > 0) hudPrice.textContent = formatChartValue(toDisplayValue(activePx));
      if (hudTimer) {
        const nextCloseMs = (bucketSec + stepSec) * 1000;
        const remSec = Math.max(0, (nextCloseMs - nowMs) / 1000);
        hudTimer.textContent = stepSec <= 60 ? `Bar close: ${remSec.toFixed(1)}s` : `Bar close: ${Math.ceil(remSec)}s`;
      }
      if (hudMode) {
        const isWs = String(p.chainId).toLowerCase() === 'solana' && pumpTradeSubscriptionActive && subscribedPumpMint === p.baseToken?.address;
        hudMode.textContent = isWs ? 'WS LIVE TICKS' : '1S LIVE FEED';
      }
    };

    const pushSpotPrice = (livePx, sourceLabel = 'LIVE') => {
      if (!(livePx > 0) || generation !== candleLoadGeneration || !mainSeries || !rawBaseCandles.length) return;
      const prevPx = latestKnownPrice;
      latestKnownPrice = livePx;
      const stepSec = getStepSec();
      const nowSec = Math.floor(Date.now() / 1000);
      const bucketSec = Math.floor(nowSec / stepSec) * stepSec;
      const lastRaw = rawBaseCandles[rawBaseCandles.length - 1];

      if (lastRaw.time === bucketSec) {
        lastRaw.high = Math.max(lastRaw.high, livePx);
        lastRaw.low = Math.min(lastRaw.low, livePx);
        lastRaw.close = livePx;
      } else if (bucketSec > lastRaw.time) {
        rawBaseCandles.push({ time: bucketSec, open: lastRaw.close, high: Math.max(lastRaw.close, livePx), low: Math.min(lastRaw.close, livePx), close: livePx, volume: 0 });
        if (rawBaseCandles.length > 500) rawBaseCandles.shift();
      }

      const activeRaw = rawBaseCandles[rawBaseCandles.length - 1];
      const dispBar = {
        time: activeRaw.time,
        open: toDisplayValue(activeRaw.open),
        high: toDisplayValue(activeRaw.high),
        low: toDisplayValue(activeRaw.low),
        close: toDisplayValue(activeRaw.close),
        volume: activeRaw.volume
      };
      const lastDisp = liveCandlesList[liveCandlesList.length - 1];
      if (lastDisp && lastDisp.time === dispBar.time) Object.assign(lastDisp, dispBar);
      else {
        liveCandlesList.push(dispBar);
        if (liveCandlesList.length > 500) liveCandlesList.shift();
      }

      if (chartStyle === 'area') mainSeries.update({ time: dispBar.time, value: dispBar.close });
      else mainSeries.update(dispBar);

      if (prevPx > 0 && Math.abs(livePx - prevPx) / prevPx >= 0.0001) {
        const side = livePx >= prevPx ? 'buy' : 'sell';
        const estVol = Math.max(15, Number(p.liquidity?.usd || 5000) * Math.min(0.02, Math.abs(livePx - prevPx) / prevPx));
        applyTradeTickToChart({
          id: `tick:${nowSec}:${livePx.toPrecision(6)}`,
          side,
          priceUsd: livePx,
          volumeUsd: estVol,
          trader: `${sourceLabel} Quote`,
          timestampSec: nowSec
        });
      }

      syncTechnicalOverlays();
      updateOhlcReadout(dispBar);
      const firstStat = $('token-stats')?.querySelector('div:first-child b');
      if (firstStat) firstStat.textContent = price(livePx);
      checkSmartTargetTriggers(livePx);
      updateHudAndClock();
    };

    const poll = async () => {
      if (generation !== candleLoadGeneration || !mainSeries || document.hidden) return;
      updateHudAndClock();
      if (pollInFlight) return;
      pollInFlight = true;
      try {
        const jobs = [];
        const isSol = String(p.chainId).toLowerCase() === 'solana';
        const pumpPortalOwnsLiveFeed = isSol
          && pumpTradeSubscriptionActive
          && subscribedPumpMint === p.baseToken?.address;

        if (poolAddr && !pumpPortalOwnsLiveFeed && Date.now() - lastTradeRefresh >= 18000) jobs.push((async () => {
          lastTradeRefresh = Date.now();
          try {
            const tradesRes = await fetchJson(`${GECKO_API}/networks/${net}/pools/${encodeURIComponent(poolAddr)}/trades`, { timeout: 4500 });
            if (generation !== candleLoadGeneration) return;
            const rawTrades = (tradesRes?.data || []).slice(0, 25).reverse();
            for (const item of rawTrades) {
              const a = item?.attributes || {};
              const side = String(a.kind || '').toLowerCase();
              if (side !== 'buy' && side !== 'sell') continue;
              const baseAddress = String(p.baseToken?.address || '').toLowerCase();
              const fromAddress = String(a.token_from_address || a.from_token_address || '').toLowerCase();
              const toAddress = String(a.token_to_address || a.to_token_address || '').toLowerCase();
              let px = 0;
              if (baseAddress && fromAddress === baseAddress) px = Number(a.price_from_in_usd || 0);
              else if (baseAddress && toAddress === baseAddress) px = Number(a.price_to_in_usd || 0);
              else px = Number(a.price_to_in_usd || a.price_from_in_usd || 0);
              const vol = Number(a.volume_in_usd || 0);
              const ts = a.block_timestamp ? Math.floor(new Date(a.block_timestamp).getTime() / 1000) : Math.floor(Date.now() / 1000);
              if (px > 0) {
                latestKnownPrice = px;
                applyTradeTickToChart({ id: item.id || `${a.tx_hash}:${ts}:${vol}`, side, priceUsd: px, volumeUsd: vol, trader: a.tx_from_address || '', timestampSec: ts });
              }
            }
          } catch {}
        })());

        if (isSol && p.baseToken?.address && !pumpPortalOwnsLiveFeed && Date.now() - lastJupRefresh >= 1100) jobs.push((async () => {
          lastJupRefresh = Date.now();
          try {
            const jupRes = await fetchJson(`https://api.jup.ag/price/v2?ids=${encodeURIComponent(p.baseToken.address)}`, { timeout: 2500 });
            if (generation !== candleLoadGeneration) return;
            const livePx = Number(jupRes?.data?.[p.baseToken.address]?.price || 0);
            if (livePx > 0) pushSpotPrice(livePx, 'Jupiter');
          } catch {}
        })());

        if (!pumpPortalOwnsLiveFeed && Date.now() - lastDexRefresh >= 1500) jobs.push((async () => {
          lastDexRefresh = Date.now();
          try {
            let latest = null;
            if (p.pairAddress) {
              try {
                const pairRes = await fetchJson(`${API}/latest/dex/pairs/${encodeURIComponent(p.chainId)}/${encodeURIComponent(p.pairAddress)}`, { timeout: 3500 });
                const candidates = pairRes?.pairs || (pairRes?.pair ? [pairRes.pair] : []);
                latest = candidates.find(x => String(x.pairAddress || '').toLowerCase() === String(p.pairAddress).toLowerCase()) || candidates[0] || null;
              } catch {}
            }
            if (!latest && p.baseToken?.address) {
              const tokenRes = await fetchJson(`${API}/latest/dex/tokens/${encodeURIComponent(p.baseToken.address)}`, { timeout: 3500 });
              const candidates = (tokenRes?.pairs || []).filter(x => String(x.chainId).toLowerCase() === String(p.chainId).toLowerCase());
              latest = candidates.find(x => p.pairAddress && String(x.pairAddress).toLowerCase() === String(p.pairAddress).toLowerCase())
                || candidates.sort((a, b) => Number(b.liquidity?.usd || 0) - Number(a.liquidity?.usd || 0))[0]
                || null;
            }
            if (!latest || generation !== candleLoadGeneration) return;
            activeToken = { ...activeToken, ...latest };
            renderOverallFlowStats(activeToken);
            const livePx = Number(latest.priceUsd);
            if (livePx > 0) pushSpotPrice(livePx, 'DEX');
          } catch {}
        })());

        await Promise.all(jobs);
      } finally {
        pollInFlight = false;
      }

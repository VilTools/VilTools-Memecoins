  function checkSmartTargetTriggers(liveUsdPrice) {
    if (!smartTradeZones || !(liveUsdPrice > 0)) return;
    if (!smartTradeZones.triggeredBuy && liveUsdPrice <= smartTradeZones.buyUsd) {
      smartTradeZones.triggeredBuy = true;
      toast(`🎯 BUY ZONE REACHED at ${formatChartValue(toDisplayValue(liveUsdPrice))}!`);
    }
    if (!smartTradeZones.triggeredSell && liveUsdPrice >= smartTradeZones.sellUsd) {
      smartTradeZones.triggeredSell = true;
      toast(`💰 SELL TARGET REACHED at ${formatChartValue(toDisplayValue(liveUsdPrice))}!`);
    }
  }

  function renderDrawingsOverlay() {
    const overlay = $('chart-draw-overlay');
    if (!overlay) return;
    const stage = $('chart-stage');
    if (stage) {
      overlay.width = stage.clientWidth;
      overlay.height = stage.clientHeight;
    }
    const ctx = overlay.getContext('2d');
    if (!ctx) return;
    ctx.clearRect(0, 0, overlay.width, overlay.height);
    if (!chart || !mainSeries) return;

    // Sync horizontal price lines on the LightweightCharts axis for hline drawings
    for (const pl of customPriceLines) {
      try { mainSeries.removePriceLine(pl); } catch {}
    }
    customPriceLines = [];

    for (const d of customDrawings) {
      const dispVal1 = toDisplayValue(d.p1.usd);
      if (d.type === 'hline' && dispVal1 > 0) {
        const pl = mainSeries.createPriceLine({
          price: dispVal1,
          color: d.color || '#f2bd58',
          lineWidth: 2,
          lineStyle: 0,
          axisLabelVisible: true,
          title: 'LEVEL'
        });
        customPriceLines.push(pl);
      } else if ((d.type === 'trend' || d.type === 'ruler') && d.p1 && d.p2) {
        const x1 = chart.timeScale().timeToCoordinate(d.p1.time);
        const y1 = mainSeries.priceToCoordinate(toDisplayValue(d.p1.usd));
        const x2 = chart.timeScale().timeToCoordinate(d.p2.time);
        const y2 = mainSeries.priceToCoordinate(toDisplayValue(d.p2.usd));
        if (x1 == null || y1 == null || x2 == null || y2 == null) continue;

        if (d.type === 'trend') {
          ctx.save();
          ctx.beginPath();
          ctx.moveTo(x1, y1);
          ctx.lineTo(x2, y2);
          ctx.strokeStyle = '#38bdf8';
          ctx.lineWidth = 2;
          ctx.stroke();
          ctx.fillStyle = '#38bdf8';
          ctx.beginPath(); ctx.arc(x1, y1, 3.5, 0, Math.PI * 2); ctx.fill();
          ctx.beginPath(); ctx.arc(x2, y2, 3.5, 0, Math.PI * 2); ctx.fill();
          ctx.restore();
        } else if (d.type === 'ruler') {
          const v1 = toDisplayValue(d.p1.usd);
          const v2 = toDisplayValue(d.p2.usd);
          const pct = v1 > 0 ? ((v2 - v1) / v1) * 100 : 0;
          const isUp = pct >= 0;
          const fill = isUp ? 'rgba(53,211,154,0.16)' : 'rgba(239,85,93,0.16)';
          const stroke = isUp ? '#35d39a' : '#ef555d';
          const left = Math.min(x1, x2), top = Math.min(y1, y2);
          const w = Math.abs(x2 - x1), h = Math.abs(y2 - y1);

          ctx.save();
          ctx.fillStyle = fill;
          ctx.strokeStyle = stroke;
          ctx.lineWidth = 1.5;
          ctx.fillRect(left, top, w, h);
          ctx.strokeRect(left, top, w, h);

          const label = `${isUp ? '+' : ''}${pct.toFixed(2)}% (${isUp ? '+' : ''}${formatChartValue(Math.abs(v2 - v1))})`;
          ctx.font = '700 11px "Space Grotesk", sans-serif';
          const tw = ctx.measureText(label).width + 16;
          const bx = Math.max(8, Math.min(overlay.width - tw - 70, left + w / 2 - tw / 2));
          const by = Math.max(44, top - 26);
          ctx.fillStyle = 'rgba(10,7,10,0.92)';
          ctx.fillRect(bx, by, tw, 22);
          ctx.strokeRect(bx, by, tw, 22);
          ctx.fillStyle = stroke;
          ctx.fillText(label, bx + 8, by + 15);
          ctx.restore();
        }
      }
    }

    // Draw live preview while placing a trendline or ruler
    if (pendingDrawPoint && hoverMousePos) {
      const x1 = chart.timeScale().timeToCoordinate(pendingDrawPoint.time);
      const y1 = mainSeries.priceToCoordinate(toDisplayValue(pendingDrawPoint.usd));
      if (x1 != null && y1 != null) {
        ctx.save();
        ctx.setLineDash([5, 4]);
        ctx.strokeStyle = activeDrawTool === 'ruler' ? '#35d39a' : '#38bdf8';
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.moveTo(x1, y1);
        ctx.lineTo(hoverMousePos.x, hoverMousePos.y);
        ctx.stroke();
        ctx.restore();
      }
    }
  }

  function applyTradeTickToChart(trade) {
    if (!trade || !(trade.priceUsd > 0)) return;
    if (trade.id && seenTradeIds.has(trade.id)) return;
    if (trade.id) {
      seenTradeIds.add(trade.id);
      if (seenTradeIds.size > 400) {
        const firstKey = seenTradeIds.values().next().value;
        seenTradeIds.delete(firstKey);
      }
    }

    liveTradeFeed.unshift(trade);
    liveTradeFeed = liveTradeFeed.slice(0, 35);
    renderTradeTape();

    if (!mainSeries || !rawBaseCandles.length) return;

    const stepSec = ({ s1: 1, s5: 5, s15: 15, live: 60, hour: 300, day: 3600, week: 86400 })[timeframe] || 60;
    const txTime = trade.timestampSec || Math.floor(Date.now() / 1000);
    const bucketSec = Math.floor(txTime / stepSec) * stepSec;
    const lastRaw = rawBaseCandles[rawBaseCandles.length - 1];
    const px = trade.priceUsd;
    const v = Math.max(0, Number(trade.volumeUsd || 0));

    if (bucketSec < lastRaw.time) return;

    if (bucketSec === lastRaw.time) {
      lastRaw.high = Math.max(lastRaw.high, px);
      lastRaw.low = Math.min(lastRaw.low, px);
      lastRaw.close = px;
      lastRaw.volume = (lastRaw.volume || 0) + v;
    } else if (bucketSec > lastRaw.time) {
      rawBaseCandles.push({
        time: bucketSec,
        open: lastRaw.close,
        high: Math.max(lastRaw.close, px),
        low: Math.min(lastRaw.close, px),
        close: px,
        volume: v
      });
      if (rawBaseCandles.length > 500) rawBaseCandles.shift();
    }

    const activeBar = rawBaseCandles[rawBaseCandles.length - 1];
    const dispBar = {
      time: activeBar.time,
      open: toDisplayValue(activeBar.open),
      high: toDisplayValue(activeBar.high),
      low: toDisplayValue(activeBar.low),
      close: toDisplayValue(activeBar.close),
      volume: activeBar.volume
    };

    const lastDisp = liveCandlesList[liveCandlesList.length - 1];
    if (lastDisp && lastDisp.time === dispBar.time) {
      Object.assign(lastDisp, dispBar);
    } else {
      liveCandlesList.push(dispBar);
      if (liveCandlesList.length > 500) liveCandlesList.shift();
    }

    if (chartStyle === 'area') {
      mainSeries.update({ time: dispBar.time, value: dispBar.close });
    } else {
      mainSeries.update(dispBar);
    }

    if (volumeSeries) {
      liveVolumeMap.set(bucketSec, activeBar.volume);
      volumeSeries.update({
        time: bucketSec,
        value: activeBar.volume,
        color: trade.side === 'buy' ? 'rgba(53,211,154,.55)' : 'rgba(239,85,93,.55)'
      });
    }

    const isBuy = trade.side === 'buy';
    chartMarkers.push({
      time: bucketSec,
      position: isBuy ? 'belowBar' : 'aboveBar',
      color: isBuy ? '#35d39a' : '#ef555d',
      shape: isBuy ? 'arrowUp' : 'arrowDown',
      text: isBuy ? 'B' : 'S'
    });
    if (chartMarkers.length > 36) chartMarkers = chartMarkers.slice(-36);

    syncTechnicalOverlays();
    updateOhlcReadout(dispBar);
    renderDrawingsOverlay();

    const firstStat = $('token-stats')?.querySelector('div:first-child b');
    if (firstStat) firstStat.textContent = price(px);
    if ($('hud-live-price')) $('hud-live-price').textContent = formatChartValue(dispBar.close);
    checkSmartTargetTriggers(px);
    evaluatePaperTriggersForMint(activeToken?.baseToken?.address, px, activeToken?.chainId);
  }


    const tokenPrice = Number(activeToken.priceUsd || 0);
    if ($('estimate')) $('estimate').textContent = tokenPrice > 0
      ? (selectedSwapSide === 'buy' ? `~${fmt(amountUsd / tokenPrice, 4)} ${activeToken.baseToken?.symbol || 'tokens'}` : 'Fetching USD sell quote…')
      : 'Fetching quote…';

    quoteDebounceTimer = setTimeout(async () => {
      try {
        const mint = activeToken.baseToken.address;
        const inputMint = selectedSwapSide === 'buy' ? SOL_MINT : mint;
        const outputMint = selectedSwapSide === 'buy' ? mint : SOL_MINT;

  async function selectAndConnectWallet(idx) {
    const choice = walletProviders()[idx];
    if (!choice) return;
    closeWalletModal();
    try {
      const result = await choice.provider.connect();
      const key = result?.publicKey || choice.provider.publicKey;
      if (!key) throw new Error('Wallet did not return a public key.');
      connectedProvider = choice.provider;
      connectedWalletName = choice.name;
      connectedPublicKey = key.toString();
      try {
        connectedProvider.on?.('accountChanged', nextPub => {
          if (nextPub) { connectedPublicKey = nextPub.toString(); walletUi(); refreshWalletBalances(); }
          else disconnectWallet();
        });
        connectedProvider.on?.('disconnect', () => disconnectWallet());

    if (chart) {
      const bgMap = { red: '#160d0e', blue: '#0d1422', green: '#0b1915', purple: '#140e24' };
      chart.applyOptions({ layout: { background: { color: bgMap[theme] || '#160d0e' } } });
    }
  }


      button.disabled = true;
      button.textContent = 'Building swap order…';
      result.className = 'trade-result';
      result.textContent = 'Fetching best route via Jupiter…';

      const params = new URLSearchParams({
        inputMint,
        outputMint,
        amount: rawAmount,
        taker: connectedPublicKey,
        slippageBps: String(DEFAULT_SLIPPAGE_BPS)
      });
      const orderRes = await fetch('https://api.jup.ag/swap/v2/order?' + params.toString());
      const order = await orderRes.json();
      if (!orderRes.ok || !order.transaction) throw new Error(order.errorMessage || order.error || 'Unable to assemble swap transaction.');

      button.textContent = 'Approve in wallet…';
      result.textContent = `Please sign the ${selectedSwapSide.toUpperCase()} transaction inside ${connectedWalletName}…`;

      const sol = await import('https://esm.sh/@solana/web3.js@1.98.4');
      const txBytes = Uint8Array.from(atob(order.transaction), c => c.charCodeAt(0));
      const tx = sol.VersionedTransaction.deserialize(txBytes);
      const signed = await connectedProvider.signTransaction(tx);
      const signedTransaction = bytesToBase64(signed.serialize());

      button.textContent = 'Submitting to Solana…';
      result.textContent = 'Executing signed swap transaction…';

      const execRes = await fetch('https://api.jup.ag/swap/v2/execute', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ signedTransaction, requestId: order.requestId })
      });
      const execution = await execRes.json();
      if (!execRes.ok || (execution.status && execution.status !== 'Success' && execution.state !== 'confirmed')) {
        throw new Error(execution.error || execution.errorMessage || 'Swap execution failed.');
      }

      const sig = execution.signature || '';
      const link = sig ? `https://solscan.io/tx/${encodeURIComponent(sig)}` : '';
      result.innerHTML = `Swap executed successfully! ${link ? `<a href="${link}" target="_blank" rel="noopener">View on Solscan ↗</a>` : ''}`;
      toast('Swap confirmed on Solana!');

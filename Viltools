  function wrapStandardWallet(sw) {
    return {
      name: sw.name || 'Solana Wallet',
      isStandard: true,
      raw: sw,
      async connect() {
        const connectFeature = sw.features['standard:connect'];
        const res = connectFeature ? await connectFeature.connect() : null;
        const acc = res?.accounts?.[0] || sw.accounts?.[0];
        if (!acc?.address) throw new Error('No account returned by wallet.');
        this._account = acc;
        return { publicKey: acc.address };
      },
      async disconnect() {
        try { await sw.features['standard:disconnect']?.disconnect?.(); } catch {}
      },
      async signTransaction(versionedTx) {
        const signFeature = sw.features['solana:signTransaction'];
        const account = this._account || sw.accounts?.[0];
        if (!signFeature || !account) throw new Error('Wallet does not support transaction signing.');
        const serialized = versionedTx.serialize();
        const outputs = await signFeature.signTransaction([{ transaction: serialized, account }]);
        const signedBytes = outputs?.[0]?.signedTransaction;
        if (!signedBytes) throw new Error('Transaction signing was rejected or empty.');
        const sol = await import('https://esm.sh/@solana/web3.js@1.98.4');
        return sol.VersionedTransaction.deserialize(signedBytes);
      }
    };
  }

  const walletProviders = () => {
    const found = [];
    const seenKeys = new Set();
    const add = (name, p) => {
      if (!p) return;
      const key = p.isPhantom ? 'phantom' : p.isSolflare ? 'solflare' : p.isBackpack ? 'backpack' : p.isCoinbaseWallet ? 'coinbase' : name;
      if (seenKeys.has(key)) return;
      seenKeys.add(key);
      found.push({ name, provider: p });
    };

    add('Phantom', window.phantom?.solana || (window.solana?.isPhantom ? window.solana : null));
    add('Solflare', window.solflare?.isSolflare ? window.solflare : window.solflare);
    add('Backpack', window.backpack || (window.solana?.isBackpack ? window.solana : null));
    add('Coinbase Wallet', window.coinbaseSolana || (window.solana?.isCoinbaseWallet ? window.solana : null));
    add('Solana Wallet', window.solana);

    for (const sw of standardWallets) {
      if (!found.some(f => f.name.toLowerCase() === (sw.name || '').toLowerCase())) {
        found.push({ name: sw.name || 'Standard Wallet', provider: wrapStandardWallet(sw) });
      }
    }
    return found;
  };

  const shortKey = k => k ? k.slice(0, 5) + '…' + k.slice(-5) : '';

  async function solanaRpc(method, params) {
    const r = await fetch('https://api.mainnet-beta.solana.com', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ jsonrpc: '2.0', id: 1, method, params })
    });
    const j = await r.json();
    if (j.error) throw new Error(j.error.message || 'Solana RPC error');
    return j.result;
  }


        register(w) {
          if (w && w.features && (w.features['solana:signTransaction'] || w.features['solana:signAndSendTransaction'])) {
            if (!standardWallets.some(existing => existing.name === w.name)) standardWallets.push(w);
          }
        }
      };
      window.dispatchEvent(new CustomEvent('wallet-standard:app-ready', { detail: api }));
      window.addEventListener('wallet-standard:register-wallet', ev => {

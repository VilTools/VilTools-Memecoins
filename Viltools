  function connectPumpStream() {
    if (pumpSocket && (pumpSocket.readyState === WebSocket.OPEN || pumpSocket.readyState === WebSocket.CONNECTING)) return;
    clearTimeout(pumpReconnectTimer);
    try {
      pumpSocket = new WebSocket('wss://pumpportal.fun/api/data' + (pumpPortalApiKey ? '?api-key=' + encodeURIComponent(pumpPortalApiKey) : ''));
      pumpSocket.addEventListener('open', () => {
        pumpSocket.send(JSON.stringify({ method: 'subscribeNewToken' }));
        pumpSocket.send(JSON.stringify({ method: 'subscribeMigration' }));
        pumpTradeSubscriptionActive = false;
        const status = $('pumpportal-status');
        if (status) status.textContent = pumpPortalApiKey
          ? 'PumpPortal connected. Subscribing to the selected token trade stream…'
          : 'PumpPortal launch feed connected. For live per-token buys/sells, configure a PumpPortal Data API key in Settings.';
        if (activeToken?.chainId === 'solana' && activeToken?.baseToken?.address) {
          updatePumpTokenSubscription(activeToken.baseToken.address);
        }
        const keyStatus = $('pumpportal-key-status');
        if (keyStatus) keyStatus.textContent = pumpPortalApiKey
          ? 'PumpPortal socket connected; live token trade subscription will activate for the selected Solana token.'
          : 'No trade-stream key configured. Solana trades use indexed fallback data.';
      });
      pumpSocket.addEventListener('message', async ev => {
        try {
          const d = JSON.parse(ev.data);
          // PumpPortal streams actual Pump.fun and PumpSwap transactions. Prefer
          // the executed trade ratio (SOL/token) over post-trade virtual reserves.
          const tradeSide = String(d.txType || d.side || '').toLowerCase();
          if ((tradeSide === 'buy' || tradeSide === 'sell') && activeToken?.baseToken?.address
              && String(d.mint || '').toLowerCase() === String(activeToken.baseToken.address).toLowerCase()) {
            const solAmt = Number(d.solAmount ?? d.quoteAmount ?? 0);
            const tokAmt = Number(d.tokenAmount ?? 0);
            const vSol = Number(d.vSolInBondingCurve ?? d.virtualQuoteReserves ?? d.poolQuoteReservesUi ?? 0);
            const vTok = Number(d.vTokensInBondingCurve ?? d.poolBaseReservesUi ?? 0);
            let solUsd = cachedSolUsdPrice;
            if (!(solUsd > 0)) solUsd = await getSolUsdPrice();
            let pxUsd = 0;
            if (solUsd > 0 && solAmt > 0 && tokAmt > 0) pxUsd = (solAmt / tokAmt) * solUsd;
            else if (solUsd > 0 && vSol > 0 && vTok > 0) pxUsd = (vSol / vTok) * solUsd;

            const rawTime = Number(d.timestamp ?? d.blockTime ?? 0);
            const timestampSec = rawTime > 1e12 ? Math.floor(rawTime / 1000)
              : rawTime > 0 ? Math.floor(rawTime) : Math.floor(Date.now() / 1000);
            if (pxUsd > 0) {
              applyTradeTickToChart({
                id: d.signature || `${d.mint}:${tradeSide}:${timestampSec}:${d.traderPublicKey || ''}`,
                side: tradeSide,
                priceUsd: pxUsd,
                volumeUsd: solAmt * solUsd,
                trader: d.traderPublicKey || d.user || '',
                timestampSec
              });
              const status = $('pumpportal-status');
              if (status) status.textContent = `Live Pump.fun / PumpSwap trades · ${String(d.pool || 'Solana').toUpperCase()} · USD candles synced`;
            }
            return;
          }

          const key = String(d.signature || d.mint || JSON.stringify(d));
          if (pumpSeen.has(key)) return;
          pumpSeen.add(key);
          if (pumpSeen.size > 500) pumpSeen.clear();
          pumpEvents.unshift({ data: d, at: Date.now() });
          pumpEvents = pumpEvents.slice(0, 25);
          renderSidePanel();
        } catch {}
      });
      pumpSocket.addEventListener('close', () => {
        clearTimeout(pumpReconnectTimer);
        pumpReconnectTimer = setTimeout(connectPumpStream, 10000);
      });
      pumpSocket.addEventListener('error', () => { try { pumpSocket.close(); } catch {} });
    } catch {}
  }


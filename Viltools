    bbLowerSeries = null;
    sessionHighLine = null;
    sessionLowLine = null;
    customPriceLines = [];
    smartPriceLines = [];

    renderProChartCanvas(rawBaseCandles);
    if (savedRange && chart) {
      try { chart.timeScale().setVisibleLogicalRange(savedRange); } catch {}
    }
    liveChartTimer = prevTimer;
  }

  function syncTechnicalOverlays() {
    if (!chart || !liveCandlesList.length) return;
    const ema9 = computeEMA(liveCandlesList, 9);
    const ema21 = computeEMA(liveCandlesList, 21);
    const vwap = computeVWAP(liveCandlesList);
    const bb = computeBollinger(liveCandlesList, 20, 2);

    if (ema9Series) ema9Series.setData(activeIndicators.ema ? ema9 : []);
    if (ema21Series) ema21Series.setData(activeIndicators.ema ? ema21 : []);
    if (vwapSeries) vwapSeries.setData(activeIndicators.vwap ? vwap : []);
    if (bbUpperSeries) bbUpperSeries.setData(activeIndicators.bb ? bb.upper : []);
    if (bbLowerSeries) bbLowerSeries.setData(activeIndicators.bb ? bb.lower : []);

    const lastEma9 = ema9[ema9.length - 1]?.value;
    const lastEma21 = ema21[ema21.length - 1]?.value;
    const lastVwap = vwap[vwap.length - 1]?.value;
    const indLeg = $('chart-ind-legend');
    if (indLeg) {
      const tags = [];
      if (activeIndicators.ema && lastEma9) tags.push(`<span style="color:#7dd3fc">EMA9: ${formatChartValue(lastEma9)}</span>`, `<span style="color:#38bdf8">EMA21: ${formatChartValue(lastEma21)}</span>`);
      if (activeIndicators.vwap && lastVwap) tags.push(`<span style="color:#fcd34d">VWAP: ${formatChartValue(lastVwap)}</span>`);
      if (activeIndicators.bb && bb.upper.length) tags.push(`<span style="color:#d8b4fe">BB(20,2)</span>`);
      indLeg.innerHTML = tags.join('');
    }

    // Session High / Low price lines
    if (mainSeries) {
      if (sessionHighLine) { try { mainSeries.removePriceLine(sessionHighLine); } catch {} sessionHighLine = null; }
      if (sessionLowLine) { try { mainSeries.removePriceLine(sessionLowLine); } catch {} sessionLowLine = null; }
      if (activeIndicators.sr && liveCandlesList.length >= 2) {
        let hi = -Infinity, lo = Infinity;
        for (const c of liveCandlesList) {
          if (c.high > hi) hi = c.high;
          if (c.low < lo) lo = c.low;
        }
        if (Number.isFinite(hi) && hi > 0) {
          sessionHighLine = mainSeries.createPriceLine({
            price: hi, color: 'rgba(53,211,154,0.55)', lineWidth: 1, lineStyle: 2, axisLabelVisible: true, title: 'HIGH'
          });
        }
        if (Number.isFinite(lo) && lo > 0 && lo < hi) {
          sessionLowLine = mainSeries.createPriceLine({
            price: lo, color: 'rgba(239,85,93,0.55)', lineWidth: 1, lineStyle: 2, axisLabelVisible: true, title: 'LOW'
          });
        }
      }
    }

    // Re-apply Smart Buy/Sell Target price lines & banner if active
    renderSmartTargetLines();
    renderPaperChartOverlays();

    // Trade execution + Smart Target markers (only supported on candlestick/bar/line series)
    if (mainSeries && typeof mainSeries.setMarkers === 'function') {
      const combined = [];
      if (activeIndicators.markers && chartMarkers.length) {
        for (const m of chartMarkers) {
          if (m.time >= liveCandlesList[0].time && m.time <= liveCandlesList[liveCandlesList.length - 1].time) {
            combined.push(m);
          }
        }
      }
      if (smartTradeZones && smartMarkers.length) {
        for (const sm of smartMarkers) {
          if (sm.time >= liveCandlesList[0].time && sm.time <= liveCandlesList[liveCandlesList.length - 1].time) {
            combined.push(sm);
          }
        }
      }
      combined.sort((a, b) => a.time - b.time);
      try { mainSeries.setMarkers(combined); } catch {}
    }
  }


  function computeSmartBuySellTargets() {
    if (!rawBaseCandles || rawBaseCandles.length < 4) {
      toast('Need at least 4 candles of price history to calculate Buy/Sell targets.');
      return;
    }

    const bars = rawBaseCandles;
    const latest = bars[bars.length - 1];
    const currentPx = latest.close;

    // 1. Identify local swing lows (support) and swing highs (resistance) from historical candles
    const swingLows = [];
    const swingHighs = [];
    for (let i = 1; i < bars.length - 1; i++) {
      if (bars[i].low <= bars[i - 1].low && bars[i].low <= bars[i + 1].low) {
        swingLows.push({ idx: i, time: bars[i].time, px: bars[i].low, vol: bars[i].volume || 0 });
      }
      if (bars[i].high >= bars[i - 1].high && bars[i].high >= bars[i + 1].high) {
        swingHighs.push({ idx: i, time: bars[i].time, px: bars[i].high, vol: bars[i].volume || 0 });
      }
    }

    // 2. Compute historical EMA 9/21, VWAP, Bollinger Bands (20, 2), and ATR(14) in raw USD price
    const ema9Arr = computeEMA(bars, Math.min(9, bars.length));
    const ema21Arr = computeEMA(bars, Math.min(21, bars.length));
    const latestEma9 = ema9Arr[ema9Arr.length - 1]?.value || currentPx;
    const latestEma21 = ema21Arr[ema21Arr.length - 1]?.value || currentPx;

    const vwapArr = computeVWAP(bars);
    const latestVwap = vwapArr[vwapArr.length - 1]?.value || currentPx;
    const bbArr = computeBollinger(bars, Math.min(20, bars.length), 2);
    const latestBbLower = bbArr.lower[bbArr.lower.length - 1]?.value || currentPx * 0.92;
    const latestBbUpper = bbArr.upper[bbArr.upper.length - 1]?.value || currentPx * 1.12;

    let trSum = 0;
    const atrPeriod = Math.min(14, bars.length - 1);
    for (let i = bars.length - atrPeriod; i < bars.length; i++) {
      const prevClose = bars[i - 1].close;
      const tr = Math.max(bars[i].high - bars[i].low, Math.abs(bars[i].high - prevClose), Math.abs(bars[i].low - prevClose));
      trSum += tr;
    }
    const atr = atrPeriod > 0 ? trSum / atrPeriod : currentPx * 0.04;

    // 3. Determine optimal Buy Zone below current price (strongest historical support confluence)
    const supportCandidates = swingLows
      .map(s => s.px)
      .filter(px => px > 0 && px < currentPx * 0.992);
    if (latestVwap < currentPx * 0.992) supportCandidates.push(latestVwap);
    if (latestBbLower < currentPx * 0.992) supportCandidates.push(latestBbLower);

    let buyUsd;
    let buyAnchorBar = bars[Math.max(0, bars.length - 2)];
    if (supportCandidates.length) {
      supportCandidates.sort((a, b) => b - a);
      const topSupport = supportCandidates[0];
      const cluster = supportCandidates.filter(px => Math.abs(px - topSupport) / topSupport <= 0.04);
      buyUsd = cluster.reduce((s, x) => s + x, 0) / cluster.length;
    } else {
      buyUsd = Math.max(currentPx * 0.85, currentPx - atr * 1.35);
    }

    let bestBuyDiff = Infinity;
    for (const b of bars.slice(-60)) {
      const diff = Math.abs(b.low - buyUsd);
      if (diff < bestBuyDiff) { bestBuyDiff = diff; buyAnchorBar = b; }
    }

    // 4. Determine optimal Take-Profit Sell Zone above current price
    const resistCandidates = swingHighs
      .map(s => s.px)
      .filter(px => px > currentPx * 1.015);
    if (latestBbUpper > currentPx * 1.015) resistCandidates.push(latestBbUpper);

    let sellUsd;
    let sellAnchorBar = bars[Math.max(0, bars.length - 2)];
    if (resistCandidates.length) {
      resistCandidates.sort((a, b) => a - b);
      const minTarget = currentPx + Math.max(atr * 1.8, (currentPx - buyUsd) * 1.5);
      sellUsd = resistCandidates.find(px => px >= minTarget) || resistCandidates[resistCandidates.length - 1];
    } else {
      sellUsd = currentPx + Math.max(atr * 2.2, (currentPx - buyUsd) * 2.0);
    }

    let bestSellDiff = Infinity;
    for (const b of bars.slice(-60)) {
      const diff = Math.abs(b.high - sellUsd);
      if (diff < bestSellDiff) { bestSellDiff = diff; sellAnchorBar = b; }
    }

    const stopUsd = Math.max(buyUsd * 0.5, buyUsd - atr * 1.1);
    const upsidePct = ((sellUsd - buyUsd) / buyUsd) * 100;
    const riskPct = Math.max(0.5, ((buyUsd - stopUsd) / buyUsd) * 100);
    const rrNum = upsidePct / riskPct;
    const rr = rrNum.toFixed(1);

    // 5. Historical reaction & bounce backtest around support/resistance zones
    let supportTouches = 0;
    let supportBounces = 0;
    for (let i = 0; i < bars.length - 3; i++) {
      const touched = bars[i].low <= buyUsd * 1.025 && bars[i].low >= buyUsd * 0.95;
      if (touched) {
        supportTouches++;
        const futureHigh = Math.max(bars[i + 1].high, bars[i + 2].high, bars[i + 3].high);
        if (futureHigh > bars[i].close * 1.015) supportBounces++;
      }
    }
    const bounceWinRate = supportTouches > 0 ? (supportBounces / supportTouches) * 100 : null;

    // 6. Multi-factor Accuracy & Buy-Quality Meter (0 - 100)
    let trendPts = 10;
    if (latestEma9 >= latestEma21) trendPts += 8;
    if (currentPx >= latestVwap * 0.985) trendPts += 7;
    trendPts = Math.max(0, Math.min(25, trendPts));

    const liqUsd = Number(activeToken?.liquidity?.usd || 0);
    const vol24Usd = Number(activeToken?.volume?.h24 || 0);
    const buys24 = Number(activeToken?.txns?.h24?.buys || 0);
    const sells24 = Number(activeToken?.txns?.h24?.sells || 0);
    const totalTx24 = buys24 + sells24;
    const buyRatio = totalTx24 > 0 ? buys24 / totalTx24 : 0.5;
    const flagsCount = activeToken ? riskFlags(activeToken).length : 1;

    let safetyPts = 8;
    if (liqUsd >= 50000) safetyPts += 8;
    else if (liqUsd >= 15000) safetyPts += 5;
    else if (liqUsd < 5000) safetyPts -= 4;

    if (vol24Usd >= 25000) safetyPts += 5;
    if (buyRatio >= 0.55) safetyPts += 6;
    else if (buyRatio < 0.42) safetyPts -= 5;
    safetyPts -= Math.min(8, flagsCount * 2);
    safetyPts = Math.max(0, Math.min(30, safetyPts));

    let rrPts = 8;
    if (rrNum >= 2.2) rrPts = 25;
    else if (rrNum >= 1.6) rrPts = 20;
    else if (rrNum >= 1.1) rrPts = 14;
    else rrPts = 7;

    let histPts = Math.min(10, Math.round((bars.length / 60) * 10));
    if (bounceWinRate != null) {
      histPts += Math.round((bounceWinRate / 100) * 10);
    } else if (swingLows.length >= 2 && swingHighs.length >= 2) {
      histPts += 6;
    }
    histPts = Math.max(0, Math.min(20, histPts));

    const accuracyScore = Math.max(5, Math.min(98, trendPts + safetyPts + rrPts + histPts));

    let verdict = 'CAUTION';
    let verdictClass = 'caution';
    let recommendation = 'Mixed conditions — wait for support confirmation and size small.';
    if (accuracyScore >= 68 && rrNum >= 1.5 && buyRatio >= 0.48) {
      verdict = 'BUY SETUP';
      verdictClass = 'enter';
      recommendation = `Favorable setup — consider entries near Buy zone (${formatChartValue(toDisplayValue(buyUsd))}) with take-profit at ${formatChartValue(toDisplayValue(sellUsd))}.`;
    } else if (accuracyScore < 45 || buyRatio < 0.38 || flagsCount >= 3) {
      verdict = 'AVOID / HIGH RISK';
      verdictClass = 'avoid';
      recommendation = 'Weak signal reliability or elevated risk flags — avoid chasing or wait for cleaner structure.';
    }

    smartTradeZones = {
      buyUsd,
      sellUsd,
      stopUsd,
      upsidePct,
      rr,
      accuracyScore,
      verdict,
      verdictClass,
      recommendation,
      sampleInfo: `${bars.length} bars · ${supportTouches > 0 ? `${supportBounces}/${supportTouches} bounces` : `${swingLows.length}L/${swingHighs.length}H swings`}`,
      factors: [
        { label: 'Trend & VWAP', val: `${trendPts}/25` },
        { label: 'Liquidity & Flow', val: `${safetyPts}/30` },
        { label: 'Risk / Reward', val: `${rr}R (${rrPts}/25)` },
        { label: 'History & Swings', val: `${histPts}/20` }
      ],
      triggeredBuy: false,
      triggeredSell: false
    };

    smartMarkers = [
      {
        time: buyAnchorBar.time,
        position: 'belowBar',
        color: '#26a69a',
        shape: 'arrowUp',
        text: `BUY TARGET ${formatChartValue(toDisplayValue(buyUsd))}`
      },
      {
        time: sellAnchorBar.time,
        position: 'aboveBar',
        color: '#ef5350',
        shape: 'arrowDown',
        text: `SELL TARGET ${formatChartValue(toDisplayValue(sellUsd))}`
      }
    ];

    $('chart-smart-targets')?.classList.add('active');
    syncTechnicalOverlays();
    toast(`${verdict} (${accuracyScore}% accuracy) · Buy ${formatChartValue(toDisplayValue(buyUsd))} / Sell ${formatChartValue(toDisplayValue(sellUsd))}`);
  }


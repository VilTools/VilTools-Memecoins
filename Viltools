      initStars();
    }

    function initStars() {
      const cfg = configs[theme] || configs.red;
      const count = Math.min(220, Math.floor((width * height) / 7500));
      stars = Array.from({ length: count }, (_, i) => {
        const isCluster = cfg.spiralArm && i % 3 === 0;
        const angle = (i / count) * Math.PI * 4;
        const radius = (i / count) * Math.min(width, height) * 0.55;
        return {
          x: isCluster ? width * 0.55 + Math.cos(angle) * radius + (Math.random() - 0.5) * 180 : Math.random() * width,
          y: isCluster ? height * 0.45 + Math.sin(angle) * radius * 0.55 + (Math.random() - 0.5) * 140 : Math.random() * height,
          r: Math.random() * 1.6 + 0.35,
          alpha: Math.random() * 0.75 + 0.2,
          twinkleSpeed: Math.random() * 0.02 + 0.005,
          twinklePhase: Math.random() * Math.PI * 2,
          vx: (Math.random() - 0.5) * cfg.speed,
          vy: (Math.random() - 0.5) * cfg.speed,
          color: cfg.starColors[Math.floor(Math.random() * cfg.starColors.length)]
        };
      });
    }

    function spawnShootingStar() {
      if (shootingStars.length < 2 && Math.random() < 0.008) {
        const cfg = configs[theme] || configs.red;
        shootingStars.push({
          x: Math.random() * width * 0.85,
          y: Math.random() * height * 0.4,
          len: Math.random() * 90 + 50,
          speed: Math.random() * 7 + 6,
          alpha: 1,
          color: cfg.starColors[1] || '#ffffff'
        });
      }
    }

    function draw() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);
      for (const s of stars) {
        s.x += s.vx; s.y += s.vy;
        if (s.x < 0) s.x = width; if (s.x > width) s.x = 0;
        if (s.y < 0) s.y = height; if (s.y > height) s.y = 0;
        s.twinklePhase += s.twinkleSpeed;
        const currentAlpha = Math.max(0.1, Math.min(0.95, s.alpha + Math.sin(s.twinklePhase) * 0.25));
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
        ctx.fillStyle = s.color;
        ctx.globalAlpha = currentAlpha;
        ctx.fill();
      }
      spawnShootingStar();
      for (let i = shootingStars.length - 1; i >= 0; i--) {
        const st = shootingStars[i];
        st.x += st.speed; st.y += st.speed * 0.45; st.alpha -= 0.018;
        if (st.alpha <= 0 || st.x > width || st.y > height) { shootingStars.splice(i, 1); continue; }
        const grad = ctx.createLinearGradient(st.x, st.y, st.x - st.len, st.y - st.len * 0.45);
        grad.addColorStop(0, st.color);
        grad.addColorStop(1, 'transparent');
        ctx.beginPath();
        ctx.moveTo(st.x, st.y);
        ctx.lineTo(st.x - st.len, st.y - st.len * 0.45);
        ctx.strokeStyle = grad;
        ctx.lineWidth = 1.4;
        ctx.globalAlpha = st.alpha;
        ctx.stroke();
      }
      ctx.globalAlpha = 1;
      frameId = requestAnimationFrame(draw);
    }

    return {
      init() {
        if (!canvas) return;
        resize();
        window.addEventListener('resize', resize);
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) draw();
        else { draw(); cancelAnimationFrame(frameId); }
      },
      setTheme(newTheme) { theme = newTheme || 'red'; initStars(); }
    };
  })();

